  "candidates": {
    "halfwidth_plus_sign": {
      "description": "「擲骰+屬性」使用半形加號而非全形＋",
      "change_type": "clarity",
      "accepted": 1,
      "rejected": 0,
      "examples": [
        { "before": "擲骰＋情感：", "after": "擲骰+情感：" }
      ]
    },
    "remove_unused_abbreviations": {
      "description": "移除定義但後續未使用的縮寫（如 PC、NPC）",
      "change_type": "clarity",
      "accepted": 1,
      "rejected": 0,
      "examples": [
        { "before": "玩家角色（以下簡稱 PC）", "after": "玩家角色" }
      ]
    },
    "campaign_terminology": {
      "description": "語境為戰役時使用「戰役」而非「遊戲」",
      "change_type": "terminology",
      "accepted": 1,
      "rejected": 0,
      "examples": [
        { "before": "長期遊戲", "after": "長期戰役" }
      ]
    }
  },
  "preferences": {
    "dice_verb_consistency": {
      "description": "骰子動詞統一使用「擲出」「擲骰」而非「骰出」「投擲」",
      "change_type": "terminology",
      "pattern": "dice rolling verbs",
      "preferred": "擲出 / 擲骰",
      "over": ["骰出", "投擲（骰子語境）"],
      "accepted": 5,
      "rejected": 0,
      "confidence": 1.0,
      "examples": [
        { "before": "骰出了 11", "after": "擲出了 11" },
        { "before": "克服危險的投擲中", "after": "克服危險的擲骰中" }
      ],
      "promoted_to_style_decisions": false
    }
  },
