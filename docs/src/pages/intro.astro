			.pact-tone {
				color: var(--ink-dim); letter-spacing: 0.3em; text-indent: 0.3em;
				font-size: clamp(0.8rem, 2.4vw, 0.95rem);
				animation: rise 1s ease-out 1.2s backwards;
			}
			.pact-desc {
				max-width: 30em; line-height: 2;
				font-size: clamp(0.95rem, 2.8vw, 1.15rem);
				animation: rise 1.2s ease-out 1.9s backwards;
			}
			.question {
				font-size: clamp(1.05rem, 3.6vw, 1.5rem); font-weight: 600;
				letter-spacing: 0.1em;
				color: var(--star);
				text-shadow: 0 0 16px rgba(255, 217, 138, 0.55);
				animation: glow-in 1.6s ease-out 0.5s backwards;
			}
			@keyframes glow-in {
				from { opacity: 0; letter-spacing: 0.45em; filter: blur(4px); }
				to { opacity: 1; letter-spacing: 0.1em; filter: blur(0); }
			}

			/* ---------- 場景 4：結尾 ---------- */
			.scene-home { cursor: default; }
			.mcircle-bg {
				position: absolute; z-index: -1; opacity: 0.16;
				width: min(90vmin, 560px);
				animation: none;
			}
			.ending {
				font-size: clamp(1.5rem, 5vw, 2.3rem); font-weight: 700;
				letter-spacing: 0.12em;
				text-shadow: 0 0 20px rgba(255, 217, 138, 0.5);
				animation: rise 1s ease-out 0.3s backwards;
			}
			.tagline {
				color: var(--ink-dim); letter-spacing: 0.14em;
				font-size: clamp(0.8rem, 2.4vw, 0.95rem);
				animation: rise 1s ease-out 1s backwards;
			}
			.actions {
				display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center;
				margin-top: 0.8rem;
				animation: rise 1s ease-out 1.6s backwards;
			}
			.btn {
				display: inline-block; padding: 0.65rem 1.5rem;
				border: 1px solid rgba(255, 217, 138, 0.6); border-radius: 999px;
				color: var(--ink); text-decoration: none;
				letter-spacing: 0.1em; font-size: clamp(0.85rem, 2.6vw, 1rem);
				transition: background 0.25s, box-shadow 0.25s, transform 0.25s;
			}
			.btn:hover { box-shadow: 0 0 16px rgba(255, 217, 138, 0.4); transform: translateY(-2px); }
			.btn-primary {
				background: linear-gradient(135deg, rgba(255, 217, 138, 0.92), rgba(242, 120, 184, 0.85));
				border-color: transparent; color: #241536; font-weight: 700;
			}
			.disclaimer {
				position: absolute; bottom: 3.4rem; left: 0; right: 0;
				color: var(--ink-dim); font-size: 0.72rem; letter-spacing: 0.08em;
				animation: rise 1s ease-out 2.2s backwards;
			}

			/* ---------- 流星轉場 ---------- */
			/* 方向由外層旋轉決定，流星一律沿自身 X 軸由 +85vmax 滑向 -85vmax */
			.sstar {
				position: absolute; inset: 0;
				display: none; pointer-events: none; z-index: 20;
				--sc: #ffd98a;
			}
			.sstar.run { display: block; }
			/* 群組切換：預設 4 顆；.arch 時改用六色扮演書流星 */
			.sstar .st-arch { display: none; }
			.sstar.arch .st-default { display: none; }
			.sstar.arch .st-arch { display: block; }
			.sstar.dir-a { transform: rotate(-35deg); }   /* 右上 → 左下 */
			.sstar.dir-b { transform: rotate(-145deg); }  /* 左上 → 右下 */
			.sstar.dir-c { transform: rotate(145deg); }   /* 左下 → 右上 */
			.sstar i {
				position: absolute; top: calc(50% + var(--o, 0vmin)); left: 50%;
				width: 46vmax; height: 3px;
				margin: -1.5px 0 0 -23vmax;
				opacity: calc(0.45 + var(--s, 1) * 0.55);
				border-radius: 999px;
				background: linear-gradient(
					to right,
					#fff,
					color-mix(in srgb, var(--sc) 80%, #fff) 5%,
					color-mix(in srgb, var(--sc) 45%, transparent) 30%,
					transparent 75%
				);
				box-shadow: 0 0 12px color-mix(in srgb, var(--sc) 80%, transparent);
			}
			.sstar i::before {
				content: ''; position: absolute;
				left: -5px; top: 50%; margin-top: -5px;
				width: 10px; height: 10px; border-radius: 50%;
				background: color-mix(in srgb, var(--sc) 30%, #fff);
				box-shadow: 0 0 18px 6px color-mix(in srgb, var(--sc) 70%, #fff);
			}
			.sstar i::after {
				content: ''; position: absolute;
				left: 0; top: 50%; transform: translateY(-50%);
				width: 100%; height: 14vmin; border-radius: 50%;
				background: linear-gradient(to right, color-mix(in srgb, var(--sc) 25%, transparent), transparent 70%);
				filter: blur(12px);
			}
			.sstar.run i { animation: sstar-run var(--dur, 0.8s) ease-in-out var(--d, 0s) both; }
			@keyframes sstar-run {
				from { transform: translateX(85vmax) scale(var(--s, 1)); }
				to { transform: translateX(-85vmax) scale(var(--s, 1)); }
			}
			/* 淺色底時預設流星改深紫（金白看不見）；六色流星以行內 --sc 指定，不受影響 */
			body.light .sstar { --sc: #6c48d8; }

			/* ---------- 跳過與指示點 ---------- */
			#skip {
				position: absolute; top: 1rem; right: 1.2rem; z-index: 10;
				background: none; border: 1px solid rgba(244, 238, 254, 0.35); border-radius: 999px;
				color: var(--ink-dim); font-size: 0.8rem; letter-spacing: 0.1em;
				padding: 0.35rem 0.9rem; cursor: pointer;
				transition: color 0.25s, border-color 0.25s;
			}
			#skip:hover { color: var(--star); border-color: var(--star); }
			body.at-end #skip { display: none; }
			.dots {
				position: absolute; bottom: 1.1rem; left: 0; right: 0; z-index: 10;
				display: flex; gap: 0.9rem; justify-content: center;
			}
			.dot {
				background: none; border: none; cursor: pointer;
				color: rgba(244, 238, 254, 0.3); font-size: 0.85rem;
				transition: color 0.25s, transform 0.25s, text-shadow 0.25s;
			}
			.dot:hover { color: var(--ink-dim); }
			.dot.active {
				color: var(--star); transform: scale(1.35);
				text-shadow: 0 0 10px var(--star);
			}

			/* ---------- RWD ---------- */
			@media (max-width: 640px) {
				.slot { flex-wrap: wrap; row-gap: 0.15rem; }
				.slot .slot-desc { margin-left: 0; flex-basis: 100%; text-align: left; }
			}

			/* ---------- 減少動態 ---------- */
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after { animation: none !important; transition: none !important; }
				.flash { display: none; }
				/* 動畫停用時：sub 7 直接切換總覽並顯示點亮色條 */
				.slot.filled::before { transform: scaleX(1); }
				.scene-arch[data-sub='7'] .stage-row { display: none; }
				.scene-arch[data-sub='7'] .overview { display: flex; }
			}
		</style>
	</body>
</html>
