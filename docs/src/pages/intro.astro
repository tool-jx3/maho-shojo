			dots.forEach((d) => d.addEventListener('click', () => goto(Number(d.dataset.i))));

			document.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowRight' || e.key === ' ') next();
				if (e.key === 'ArrowLeft') goto(current - 1);
			});

