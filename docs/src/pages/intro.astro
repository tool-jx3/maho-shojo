---
// ============================================
// 序章頁文案資料區
// 想調整任何文字，改這裡即可，不需動下方版面與動畫
// ============================================

const TITLE_CHARS = '魔法少女';
const SUBTITLE = '魔法少女 TRPG・Powered by the Apocalypse';

const VERSES = ['光明的子女們！', '黑暗籠罩了世界，', '讓心中的光甦醒吧！'];
const INTRO_MAIN =
	'與夥伴一同講述屬於你們的魔法少女故事——對抗逆境、經歷浪漫、享受日常的小小奇蹟，同時試著理解心中蘊藏的力量。';
const INTRO_META = 'PbtA 敘事系統・2d6・2–6 人';

// 配色取自規則書各原型標題字（color→color2 為色塊漸層兩端）
// desc＝總覽色條的一句話；intro＝聚光燈單獨呈現時的完整介紹（取材自規則書原型章）
const ARCHETYPES = [
	{
		name: '勇者', move: '受眷顧者',
		desc: '內心蘊藏巨大潛能，與眾人分享光明的主角。',
		intro: '因心中蘊藏的巨大潛能而被選中，傳說中最強的魔法少女。她永遠相信他人，毫不猶豫走上對抗黑暗之路——因為與夥伴同行，才能把內心的光分享給全世界。',
		color: '#4790aa', color2: '#26607b',
	}, // La Campeona 藍綠
	{
		name: '參謀', move: '天才',
		desc: '理性至上、先動腦再出手的謀士。',
		intro: '不被情緒牽著走，永遠把理性放在首位。她研究黑暗、擬定策略、預見一切，是維繫團隊凝聚與專注的中樞——只是當感情介入時，天才也會犯錯。',
		color: '#7c34a6', color2: '#45175e',
	}, // La Consejera 深紫
	{
		name: '衛士', move: '光之盾',
		desc: '化身盾牌守護眾人，逆境中愈發堅強。',
		intro: '下定決心阻止世界的苦難，挺身化為眾人之盾。你永遠可以信賴她會在那裡，伸出手讓你重新站起；而她也將學會，守護世界的重擔不必獨自承受。',
		color: '#8f3da0', color2: '#c22f57',
	}, // La Guardiana 紫→緋紅
	{
		name: '鬥士', move: '戰士之道',
		desc: '正面迎擊黑暗、不拐彎抹角的行動派。',
		intro: '以最直接的方式迎擊黑暗，不耍花招、不拐彎抹角。她的果斷與魅力激勵著身邊所有人全力以赴——雖然那份驕傲，偶爾也讓她顯得笨拙。',
		color: '#d63a4a', color2: '#2b9e8f',
	}, // La Guerrera 紅→藍綠
	{
		name: '偶像', move: '超級巨星',
		desc: '以熱情與人氣為力量的眾人焦點。',
		intro: '站在聚光燈下的眾人焦點，敏銳得超乎表面。她的力量源自強烈的情感，能理解他人所忽視的心緒——以熱情為動力，即使在最絕望的時刻也能歌唱著取勝。',
		color: '#d066c0', color2: '#8f4b9e',
	}, // La Idol 粉紫
	{
		name: '聖母', move: '聖光',
		desc: '與光明深刻連結、不可或缺的支援核心。',
		intro: '擁有深刻連結內心與光明的豐富靈魂，沉穩寧靜、知道何時該行動。她以微笑守望夥伴，在朋友們面對黑暗時，成為不可或缺的支柱——即使重擔總是獨自承受。',
		color: '#97b0cd', color2: '#52719c',
	}, // La Sanadora 銀藍
];

const PACTS = [
	{ name: '光明子女', tone: '經典・日常', desc: '黑暗退居幕後，羈絆與小小奇蹟的溫馨日常。', color: '#ffd98a' },
	{ name: '正義騎士', tone: '王道・戰鬥', desc: '與夥伴並肩對抗黑暗，最經典的王道魔法少女。', color: '#7fb8f2' },
	{ name: '契約傀儡', tone: '現代・黑暗', desc: '力量既是祝福也是詛咒，緊握終將逝去的幸福。', color: '#9b6ee8' },
];
const FINAL_QUESTION = '你會成為正義的騎士，還是黑暗的傀儡？';

const ENDING_TITLE = '來玩 Mahō Shōjo，一探究竟。';
const ENDING_LINKS = [
	{ text: '開始閱讀規則 →', href: '/rules/introduction/', primary: true },
	{ text: '盟約與扮演書測驗', href: '/quiz/', primary: false },
];
const DISCLAIMER = '非官方繁體中文翻譯｜原作 Rubén Saldaña・Nosolorol Ediciones';

const CHAPTER_NAMES = ['開場', '第一章', '第二章', '第三章', '結尾'];

// 轉場流星群：o=垂直偏移(vmin)、s=大小倍率、d=延遲(s)、dur=時長(s)
const SSTARS = [
	{ o: 0, s: 1, d: 0, dur: 0.8 }, // 主星
	{ o: -16, s: 0.5, d: 0.1, dur: 0.85 },
	{ o: 10, s: 0.38, d: 0.18, dur: 0.9 },
	{ o: 22, s: 0.3, d: 0.26, dur: 0.85 },
];

// 扮演書→盟約 的六色流星：顏色對應六本扮演書
const ARCH_SSTARS = ARCHETYPES.map((a, i) => ({
	color: a.color,
	o: [0, -18, 12, -8, 22, -26][i],
	s: [0.9, 0.55, 0.6, 0.45, 0.5, 0.4][i],
	d: [0, 0.08, 0.14, 0.22, 0.3, 0.36][i],
	dur: [0.8, 0.85, 0.9, 0.85, 0.9, 0.85][i],
}));

// 星光粒子（固定座標，deterministic）
const STARS = [
	[8, 12, 2, 0], [22, 78, 3, 1.2], [35, 30, 2, 2.1], [48, 85, 2, 0.6],
	[55, 15, 3, 1.8], [67, 62, 2, 0.3], [78, 22, 2, 2.6], [88, 70, 3, 1.5],
	[15, 50, 2, 3.0], [42, 55, 2, 0.9], [62, 40, 2, 2.4], [93, 38, 2, 0.4],
	[5, 88, 2, 1.1], [70, 90, 2, 2.9], [28, 8, 2, 1.7], [84, 8, 2, 0.8],
];
---

<html lang="zh-TW">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>魔法少女──序章</title>
		<meta name="description" content="Mahō Shōjo 魔法少女 TRPG 序章導覽——六大原型、三種盟約與光暗故事的動畫介紹。" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#12102a" />
		<meta property="og:title" content="魔法少女──序章" />
		<meta property="og:description" content="Mahō Shōjo 魔法少女 TRPG 序章導覽——六大原型、三種盟約與光暗故事的動畫介紹。" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://maho-shojo.vercel.app/intro/" />
		<meta property="og:image" content="https://maho-shojo.vercel.app/og-image.jpg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://maho-shojo.vercel.app/og-image.jpg" />
	</head>
	<body>
		<main class="magia" id="stage">
			<div class="gtone" aria-hidden="true"></div>
			<div class="stars" aria-hidden="true">
				{STARS.map(([x, y, s, d]) => (
					<span style={`left:${x}%;top:${y}%;width:${s}px;height:${s}px;animation-delay:${d}s`} />
				))}
			</div>

			<button id="skip" type="button">跳過 ≫</button>

			<!-- 場景 0：開場動畫 -->
			<section class="scene scene-open active" data-chapter="0">
				<div class="mcircle">
					<div class="ring ring1"></div>
					<div class="ring ring2"></div>
					<div class="core"></div>
				</div>
				<p class="romaji">Mahō Shōjo</p>
				<h1 class="title">
					{TITLE_CHARS.split('').map((c, i) => (
						<span class="char" style={`--i:${i}`}>{c}</span>
					))}
				</h1>
				<p class="sub">{SUBTITLE}</p>
				<i class="flash" data-final></i>
			</section>

			<!-- 場景 1：第一章「光明的子女們」 -->
			<section class="scene scene-verse" data-chapter="1">
				<div class="verse">
					{VERSES.map((v, i) => (
						<p class="verse-line" style={`--i:${i}`}>{v}</p>
					))}
				</div>
				<p class="divider" aria-hidden="true">✦</p>
				<p class="main-text">{INTRO_MAIN}</p>
				<p class="meta-text">{INTRO_META}</p>
				<i class="hold" data-final style="animation-duration:9.5s"></i>
			</section>

			<!-- 場景 2：第二章「扮演書」（分幕：標題消散 → 六顆幽靈星逐一點亮 → 展開總覽） -->
			<section class="scene scene-arch" data-chapter="2" data-sub="0">
				<div class="sub-phase" data-phase="0">
					<h2 class="phase-word">扮演書</h2>
					<i class="hold" data-subfinal style="animation-duration:2.6s"></i>
				</div>
				<div class="arch-stage">
					<div class="stage-row">
						<div class="ghost-col">
							{[0, 2, 4].map((k) => (
								<span class="gstar" data-k={k} style={`--ac:${ARCHETYPES[k].color}`}>✦</span>
							))}
						</div>
						<div class="stage-spot">
							{ARCHETYPES.map((a, i) => (
								<article class={i % 2 ? 'spot spot-r' : 'spot'} style={`--ac:${a.color};--ac2:${a.color2}`}>
									<h3>{a.name}</h3>
									<p class="move">{a.move}</p>
									<p class="desc">{a.intro}</p>
								</article>
							))}
						</div>
						<div class="ghost-col">
							{[1, 3, 5].map((k) => (
								<span class="gstar" data-k={k} style={`--ac:${ARCHETYPES[k].color}`}>✦</span>
							))}
						</div>
					</div>
					<div class="overview">
						<div class="shelf">
							{ARCHETYPES.map((a, i) => (
								<div class="slot" style={`--ac:${a.color};--ac2:${a.color2};--i:${i}`}>
									<h3>{a.name}</h3>
									<p class="slot-move">{a.move}</p>
									<p class="slot-desc">{a.desc}</p>
								</div>
							))}
						</div>
					</div>
				</div>
				{ARCHETYPES.map((_, i) => (
					<div class="sub-phase" data-phase={i + 1}>
						<i class="hold" data-subfinal style="animation-duration:4.2s"></i>
					</div>
				))}
				<div class="sub-phase" data-phase="7">
					<i class="hold" data-final style="animation-duration:4.5s"></i>
				</div>
			</section>

			<!-- 場景 3：第三章「盟約」（分幕：標題消散 → 三種盟約各自登場 → 問句） -->
			<section class="scene scene-pact" data-chapter="3" data-sub="0">
				{PACTS.map((_, i) => <div class={`tone tone-${i + 1}`} aria-hidden="true"></div>)}
				<div class="sub-phase" data-phase="0">
					<h2 class="phase-word">盟約</h2>
					<i class="hold" data-subfinal style="animation-duration:4.2s"></i>
				</div>
				{PACTS.map((p, i) => (
					<div class="sub-phase" data-phase={i + 1} style={`--pc:${p.color}`}>
						<h3 class="pact-name">{p.name}</h3>
						<p class="pact-tone">{p.tone}</p>
						<p class="pact-desc">{p.desc}</p>
						<i class="hold" data-subfinal style="animation-duration:6.5s"></i>
					</div>
				))}
				<div class="sub-phase" data-phase="4">
					<p class="question">{FINAL_QUESTION}</p>
					<i class="hold" data-final style="animation-duration:5s"></i>
				</div>
			</section>

			<!-- 場景 4：結尾首頁 -->
			<section class="scene scene-home" data-chapter="4">
				<div class="mcircle mcircle-bg" aria-hidden="true">
					<div class="ring ring1"></div>
					<div class="ring ring2"></div>
				</div>
				<h2 class="ending">{ENDING_TITLE}</h2>
				<p class="tagline">{SUBTITLE}</p>
				<nav class="actions">
					{ENDING_LINKS.map((l) => (
						<a class={l.primary ? 'btn btn-primary' : 'btn'} href={l.href}>{l.text}</a>
					))}
				</nav>
				<footer class="disclaimer">{DISCLAIMER}</footer>
			</section>

			<div class="sstar" id="sstar" aria-hidden="true">
				{SSTARS.map((s) => <i class="st-default" style={`--o:${s.o}vmin;--s:${s.s};--d:${s.d}s;--dur:${s.dur}s`}></i>)}
				{ARCH_SSTARS.map((s) => (
					<i class="st-arch" style={`--o:${s.o}vmin;--s:${s.s};--d:${s.d}s;--dur:${s.dur}s;--sc:${s.color}`}></i>
				))}
			</div>

			<nav class="dots" aria-label="章節">
				{CHAPTER_NAMES.map((n, i) => (
					<button class={i === 0 ? 'dot active' : 'dot'} type="button" data-i={i} aria-label={n}>✦</button>
				))}
			</nav>
		</main>

		<script>
			const scenes = [...document.querySelectorAll('.scene')];
			const dots = [...document.querySelectorAll('.dot')];
			const last = scenes.length - 1;
			const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
			const pactScene = document.querySelector('.scene-pact');
			const archScene = document.querySelector('.scene-arch');
			let current = 0;

			const subLastOf = (sc) => sc.querySelectorAll('.sub-phase').length - 1;

			// 淺色調：場景 1、2 與盟約章前兩幕（盟約標題、光明子女）為淺色，
			// 之後隨正義騎士、契約傀儡逐漸轉暗回夜色
			function applyTone() {
				const sub = pactScene instanceof HTMLElement ? Number(pactScene.dataset.sub || '0') : 0;
				const light = current === 1 || current === 2 || (current === 3 && sub <= 1);
				document.body.classList.toggle('light', light);
			}

			// 幽靈星舞台：依目前分幕更新星星（now＝放送中、lit＝已點亮）、聚光燈與總覽色條
			function updateShelf() {
				if (!(archScene instanceof HTMLElement)) return;
				const sub = Number(archScene.dataset.sub || '0');
				archScene.querySelectorAll('.gstar').forEach((el) => {
					const k = Number(el.dataset.k || '0');
					el.classList.toggle('now', sub === k + 1);
					el.classList.toggle('lit', sub > k + 1);
				});
				archScene.querySelectorAll('.slot').forEach((el, i) => {
					el.classList.toggle('filled', sub > i + 1);
				});
				archScene.querySelectorAll('.spot').forEach((el, i) => {
					el.classList.toggle('on', sub === i + 1);
				});
			}

			// 終幕：六星（固定定位分身）飛往色條起點後不停頓，繼續往內劃過色條寬度、
			// 與色條掃開同步（星星是劃開色條的筆尖），劃到底淡出
			function finale() {
				if (!(archScene instanceof HTMLElement)) return;
				if (Number(archScene.dataset.sub || '0') !== 7) return;
				const stage = document.getElementById('stage');
				const stars = [...archScene.querySelectorAll('.gstar')].sort(
					(a, b) => Number(a.dataset.k) - Number(b.dataset.k),
				);
				const starRects = stars.map((el) => el.getBoundingClientRect());
				// 借用最終版面量出各色條位置（同一影格內還原，使用者看不見）
				archScene.classList.add('measuring');
				const slotRects = [...archScene.querySelectorAll('.slot')].map((el) => el.getBoundingClientRect());
				archScene.classList.remove('measuring');
				stars.forEach((star, k) => {
					const from = starRects[k];
					const t = slotRects[k];
					const cx = from.left + from.width / 2;
					const cy = from.top + from.height / 2;
					// 色條掃開起點與終點（偶數左→右、奇數右→左，與掃入方向一致）
					const ox = k % 2 === 0 ? t.left + 12 : t.right - 12;
					const ex = k % 2 === 0 ? t.right - 12 : t.left + 12;
					const ty = t.top + t.height / 2;
					const fly = document.createElement('span');
					fly.className = 'gstar-fly';
					fly.textContent = '✦';
					const cs = getComputedStyle(star);
					fly.style.left = `${from.left}px`;
					fly.style.top = `${from.top}px`;
					fly.style.fontSize = cs.fontSize;
					fly.style.color = cs.color;
					stage?.appendChild(fly);
					star.style.visibility = 'hidden';
					fly.animate(
						[
							{ transform: 'translate(0, 0) scale(1)', opacity: 1 },
							{ transform: `translate(${ox - cx}px, ${ty - cy}px) scale(1.25)`, opacity: 1, offset: 0.5 },
							{ transform: `translate(${ex - cx}px, ${ty - cy}px) scale(0.7)`, opacity: 0 },
						],
						{ duration: 1000, delay: k * 80, easing: 'ease-in-out', fill: 'forwards' },
					);
				});
				// 星星劃過起點的瞬間換裝，色條以相同節奏（0.08s 間隔）跟著星星展開
				setTimeout(() => {
					if (Number(archScene.dataset.sub || '0') !== 7) return;
					archScene.classList.add('finale-bars');
				}, 500);
				setTimeout(() => {
					document.querySelectorAll('.gstar-fly').forEach((el) => el.remove());
				}, 1600);
			}

			function setSub(sc, n) {
				if (sc instanceof HTMLElement) {
					if (sc === archScene && !reduced) {
						const s = Number(sc.dataset.sub || '0');
						// 扮演書退場：反向往入場方向摺回，與新書入場重疊（含第六本接終幕）
						if (s >= 1 && s <= 6 && n > s) {
							const old = sc.querySelectorAll('.spot')[s - 1];
							if (old) {
								old.classList.add('out');
								setTimeout(() => old.classList.remove('out'), 600);
							}
						}
						// 進入總覽：等聖母摺回、星星點亮後再起飛
						if (n === 7) setTimeout(finale, 650);
					}
					sc.dataset.sub = String(n);
				}
				applyTone();
				updateShelf();
			}

			function show(n) {
				current = Math.max(0, Math.min(n, last));
				scenes.forEach((s, i) => s.classList.toggle('active', i === current));
				dots.forEach((d, i) => d.classList.toggle('active', i === current));
				document.body.classList.toggle('at-end', current === last);
				// 含分幕的場景一律重設回第一幕，重新進入時從頭重播
				scenes.forEach((s) => {
					if (s instanceof HTMLElement && s.querySelector('.sub-phase')) s.dataset.sub = '0';
				});
				if (archScene instanceof HTMLElement) {
					archScene.classList.remove('finale-bars', 'measuring');
					archScene.querySelectorAll('.gstar').forEach((el) => {
						el.style.visibility = '';
						el.getAnimations().forEach((a) => a.cancel());
					});
				}
				document.querySelectorAll('.gstar-fly').forEach((el) => el.remove());
				applyTone();
				updateShelf();
			}

			const sstar = document.getElementById('sstar');
			const STAR_DIRS = { 2: 'dir-a', 3: 'dir-b', 4: 'dir-c' };
			let transitioning = false;

			// 流星轉場：往場景 2／3／4 各由不同方向的流星劃過，中點時切換場景
			function goto(n) {
				n = Math.max(0, Math.min(n, last));
				if (n === current || transitioning) return;
				const dir = STAR_DIRS[n];
				if (reduced || !dir || !sstar) {
					show(n);
					return;
				}
				transitioning = true;
				// 扮演書→盟約且正在總覽幕：書架色條先收闔（約 0.65 秒）再放流星
				const sc = scenes[current];
				const recap =
					n === 3 && current === 2 && sc instanceof HTMLElement && Number(sc.dataset.sub || '0') === subLastOf(sc)
						? sc.querySelector('.shelf')
						: null;
				if (recap) recap.classList.add('closing');
				setTimeout(() => {
