---
// ============================================
// 角色卡建立頁（純前端，無後端）
// 規則資料由 scripts/extract_rules.py 從 rules/*.md 抽出至 src/data/rules.json
// ============================================
import rules from '../data/rules.json';

const THEMES = ['動物', '鎖鏈', '夢境', '大地', '水', '火', '空氣', '木', '金屬', '時間', '卡牌', '心形', '花朵', '劍', '自然', '光', '黑暗', '月亮', '彩虹', '布料', '星星', '太陽', '音樂'];
const COLORS = ['紅色', '橘色', '黃色', '綠色', '藍色', '紫色', '粉紅色', '白色', '棕色', '灰色', '金色', '銀色', '黑色'];
const TALISMANS = ['耳環', '戒指', '胸針', '手錶', '手環', '香水', '魔法棒', '寶石', '手機'];
const ZODIACS = ['牡羊座', '金牛座', '雙子座', '巨蟹座', '獅子座', '處女座', '天秤座', '天蠍座', '射手座', '摩羯座', '水瓶座', '雙魚座'];
const BLOODS = ['A 型', 'B 型', 'AB 型', 'O 型'];
const HEART_CATS = [
	{ key: 'A', label: '攻擊（A）' },
	{ key: 'D', label: '防禦（D）' },
	{ key: 'P', label: '支援（P）' },
	{ key: 'F', label: '終曲' },
];

const OPTIONS = { THEMES, COLORS, TALISMANS, ZODIACS, BLOODS, HEART_CATS };
---

<html lang="zh-TW">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>魔法少女──角色卡建立</title>
		<meta name="description" content="Mahō Shōjo 魔法少女 TRPG 角色卡建立工具——選擇扮演書與盟約，即時預覽並列印 A4 角色卡，支援 JSON 與網址分享。" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#12102a" />
		<meta property="og:title" content="魔法少女──角色卡建立" />
		<meta property="og:description" content="選擇扮演書與盟約，即時預覽並列印 A4 角色卡，支援 JSON 與網址分享。" />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/og-image.jpg" />
	</head>
	<body>
		<script type="application/json" id="rules-data" set:html={JSON.stringify(rules)}></script>
		<script type="application/json" id="opts-data" set:html={JSON.stringify(OPTIONS)}></script>

		<header class="topbar no-print">
			<div class="brand">
				<a class="home" href="/" title="回到文件站">✦</a>
				<h1>角色卡建立</h1>
				<span class="sub">Mahō Shōjo・魔法少女</span>
			</div>
			<div class="tools">
				<button type="button" id="btn-import">匯入 JSON</button>
				<button type="button" id="btn-export">匯出 JSON</button>
				<button type="button" id="btn-share">複製分享網址</button>
				<button type="button" id="btn-print" class="primary">列印／PDF</button>
				<button type="button" id="btn-reset" class="ghost">重設</button>
				<input type="file" id="file-input" accept="application/json,.json" hidden />
			</div>
		</header>

		<p class="toast no-print" id="toast" role="status" aria-live="polite"></p>

		<main class="wrap">
			<section class="builder no-print" id="builder" aria-label="建立步驟"></section>
			<section class="preview" aria-label="角色卡預覽">
				<div class="sheet" id="sheet"></div>
			</section>
		</main>

		<footer class="foot no-print">
			<span>資料只存在你的瀏覽器與網址中，不會上傳任何伺服器。</span>
			<a href="/rules/character-creation/">角色建立規則 →</a>
		</footer>

		<script>
			// ========== 資料載入 ==========
			const RULES = JSON.parse(document.getElementById('rules-data').textContent);
			const OPTS = JSON.parse(document.getElementById('opts-data').textContent);
			const ATTRS = RULES.attributeKeys;
			const $ = (s, r) => (r || document).querySelector(s);
			const el = (tag, cls, txt) => {
				const n = document.createElement(tag);
				if (cls) n.className = cls;
				if (txt != null) n.textContent = txt;
				return n;
			};
			const sign = (n) => (n > 0 ? '+' + n : String(n));

			// ========== 狀態 ==========
			const BLANK = {
				v: 1, pb: '', name: '', life: '', age: '',
				title: '', theme: '', color: '', talisman: '', zodiac: '', blood: '', treasure: '',
				attrSet: 0, bumps: [], sig: [],
				pact: '', pactMoves: [], pactAdv: [], darkMoves: [], lostCoop: [],
				fr: '', frMoves: [], rom: '', romMoves: [],
				power: 1, superForm: false, triumphForm: false, sigExtra: 0,
				hearts: [{ name: '', cat: 'A', effect: '' }],
				advMoves: [], shine: 0, players: 4, advances: [],
				light: 0, dark: 0, darkLv: 0, cons: [], bonds: '', notes: '',
			};
			let S = structuredClone(BLANK);

			const playbook = () => RULES.playbooks.find((p) => p.name === S.pb) || null;
			const pact = () => RULES.pacts.find((p) => p.name === S.pact) || null;
			const frBook = () => RULES.friendship.find((p) => p.name === S.fr) || null;
			const romBook = () => RULES.romance.find((p) => p.name === S.rom) || null;

			// 依扮演書計算最終屬性（基礎／組合 + 加值）
			function finalAttrs() {
				const pb = playbook();
				const out = {};
				ATTRS.forEach((k) => (out[k] = 0));
				if (!pb) return out;
				const a = pb.attributes;
				const base = a.mode === 'sets' ? (a.sets[S.attrSet] || a.sets[0]).values : a.values;
				ATTRS.forEach((k) => (out[k] = base[k] ?? 0));
				(S.bumps || []).forEach((b) => {
					if (out[b.k] == null) return;
					out[b.k] += b.d;
				});
				return out;
			}

			// 依「已完成」的成長紀錄套用效果：屬性、動作、形態、招牌額外選項
			function applyAdvances() {
				const pb = playbook();
				if (!pb) return;
				S.bumps = (S.bumps || []).filter((b) => !b.fromAdv);
				S.advMoves = [];
				S.superForm = false;
				S.triumphForm = false;
				S.sigExtra = 0;
				S.advances.forEach((a) => {
					if (!a.done || !a.opt) return;
					if (a.opt.indexOf('提升一項屬性') >= 0 && a.detail) {
						S.bumps.push({ k: a.detail, d: 1, fromAdv: true });
					} else if (a.opt.indexOf('進階動作') >= 0 && a.detail !== '') {
						const i = parseInt(a.detail, 10);
						if (!isNaN(i) && !S.advMoves.includes(i)) S.advMoves.push(i);
					} else if (a.opt.indexOf('友情扮演書動作') >= 0) {
						/* 友情動作由 advGrantedFr() 併入，不寫回 S.frMoves */
					} else if (a.detail === 'super') {
						S.superForm = true;
					} else if (a.detail === 'triumph') {
						S.superForm = true;
						S.triumphForm = true;
					} else if (a.detail === 'sig3') {
						S.sigExtra += 3;
					}
				});
			}

			// ========== 網址序列化（純前端，無後端） ==========
			const b64e = (bytes) => {
				let s = '';
				bytes.forEach((b) => (s += String.fromCharCode(b)));
				return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
			};
			const b64d = (str) => {
				const s = atob(str.replace(/-/g, '+').replace(/_/g, '/'));
				const out = new Uint8Array(s.length);
				for (let i = 0; i < s.length; i++) out[i] = s.charCodeAt(i);
				return out;
			};
			async function encodeState() {
				const json = JSON.stringify(S);
				const raw = new TextEncoder().encode(json);
				if (typeof CompressionStream === 'function') {
					const cs = new CompressionStream('deflate-raw');
					const buf = await new Response(
						new Blob([raw]).stream().pipeThrough(cs)
					).arrayBuffer();
					return 'z' + b64e(new Uint8Array(buf));
				}
				return 'p' + b64e(raw);
			}
			async function decodeState(str) {
				const kind = str[0];
				const bytes = b64d(str.slice(1));
				let raw = bytes;
				if (kind === 'z') {
					const ds = new DecompressionStream('deflate-raw');
					const buf = await new Response(
						new Blob([bytes]).stream().pipeThrough(ds)
					).arrayBuffer();
					raw = new Uint8Array(buf);
				}
				return JSON.parse(new TextDecoder().decode(raw));
			}

			let urlTimer = null;
			function syncURL() {
				clearTimeout(urlTimer);
				urlTimer = setTimeout(async () => {
					try {
						const code = await encodeState();
						history.replaceState(null, '', '#c=' + code);
					} catch (e) {
						/* 忽略：網址同步失敗不影響編輯 */
					}
				}, 300);
			}

			function toast(msg) {
				const t = $('#toast');
				t.textContent = msg;
				t.classList.add('show');
				setTimeout(() => t.classList.remove('show'), 2400);
			}

			// 由規則資料的 table 欄位建出真正的表格
			function tableNode(t, cls) {
				const tb = el('table', cls || 'minitable');
				const th = el('thead');
				const htr = el('tr');
				t.headers.forEach((h) => htr.appendChild(el('th', null, h)));
				th.appendChild(htr);
				tb.appendChild(th);
				const body = el('tbody');
				t.rows.forEach((r) => {
					const tr = el('tr');
					r.forEach((c) => tr.appendChild(el('td', null, c)));
					body.appendChild(tr);
				});
				tb.appendChild(body);
				return tb;
			}

			// 官方扮演書上每項成長前方的欄位數（可重複選取的次數）；基礎成長與進階成長各自獨立計算
			function advBoxUsed(text, isAdvanced, skipIdx) {
				let n = 0;
				S.advances.forEach((x, i) => {
					if (i === skipIdx) return;
					if ((i >= 5) !== isAdvanced) return;
					if (x.opt && x.opt === text) n++;
				});
				return n;
			}
			// 以 CSS 方框呈現欄位／勾選狀態，實心與空心大小一致
			function boxRow(total, used) {
				const w = el('span', 'boxrow');
				for (let i = 0; i < total; i++) w.appendChild(el('i', 'bx' + (i < used ? ' on' : '')));
				return w;
			}

			const doneAdvCount = () => S.advances.filter((a) => a.done).length;
			// 盟約動作／盟約優勢：建立時 1 項，第六次成長再 1 項
			const pactPickLimit = () => (doneAdvCount() >= 6 ? 2 : 1);
			// 友情動作：建立時 1 個；光明子女盟約動作「友情是世界上最珍貴的寶物」再 +1
			function frPickLimit() {
				const pc = pact();
				if (!pc) return 1;
				const bonus = (S.pactMoves || []).some(
					(i) => ((pc.moves || [])[i] || {}).name === '友情是世界上最珍貴的寶物'
				);
				return bonus ? 2 : 1;
			}

			// 成長的前置條件（規則「成長類型」）：不符合時該項成長不可選擇
			function advBlockReason(text, idx) {
				if (text.indexOf('超級形態') >= 0 && idx < 2) return '需先取得 2 次成長';
				return '';
			}

			// 成長欄位總覽：對應官方扮演書上每項成長前方的 ○
			function advBoxTable(cls) {
				const pb = playbook();
				const wrap = el('div', cls || 'advboxes');
				[
					['基礎成長', pb.basicAdvances, false],
					['進階成長', pb.advancedAdvances, true],
				].forEach(([label, pool, isAdvanced]) => {
					const col = el('div', 'advboxcol');
					col.appendChild(el('b', null, label));
					const ul = el('ul', 'advboxlist');
					pool.forEach((o) => {
						const used = advBoxUsed(o.text, isAdvanced, -1);
						const li = el('li', used >= o.boxes ? 'full' : null);
						li.appendChild(boxRow(o.boxes, used));
						li.appendChild(el('span', null, o.text));
						ul.appendChild(li);
					});
					col.appendChild(ul);
					wrap.appendChild(col);
				});
				return wrap;
			}

			// 由成長取得的友情動作（與手動勾選分開，避免互相覆蓋）
			function advGrantedFr() {
				const out = [];
				S.advances.forEach((a) => {
					if (a.done && a.opt && a.opt.indexOf('友情扮演書動作') >= 0 && a.detail !== '') {
						const i = parseInt(a.detail, 10);
						if (!isNaN(i) && !out.includes(i)) out.push(i);
					}
				});
				return out;
			}
			const effFrMoves = () => {
				const g = advGrantedFr();
				return (S.frMoves || []).concat(g.filter((i) => !(S.frMoves || []).includes(i)));
			};

			// 目前生效的能力量表：可能被盟約優勢／黑暗動作取代，或多一個額外形態
			function luxView() {
				const pb = playbook();
				const pc = pact();
				let replace = null;
				let extra = null;
				if (pc) {
					const picked = []
						.concat((pc.advantages || []).filter((a, i) => (S.pactAdv || []).includes(i)))
						.concat((pc.moves || []).filter((m, i) => (S.pactMoves || []).includes(i)))
						.concat(((pc.darkMoves || {})[S.pb] || []).filter((m, i) => (S.darkMoves || []).includes(i)));
					picked.forEach((m) => {
						if (m.tableKind === 'replaceLux' && !replace) replace = m;
						if (m.tableKind === 'extraForm' && !extra) extra = m;
					});
				}
				return { rows: pb ? pb.lux : [], replace, extra };
			}

			// ========== 小工具：建立表單控制項 ==========
			function field(label, node) {
				const w = el('label', 'field');
				w.appendChild(el('span', 'flabel', label));
				w.appendChild(node);
				return w;
			}
			function textInput(key, ph) {
				const i = el('input');
				i.type = 'text';
				i.value = S[key] || '';
				if (ph) i.placeholder = ph;
				i.addEventListener('input', () => {
					S[key] = i.value;
					renderSheet();
					syncURL();
				});
				return i;
			}
			function comboInput(key, list, ph) {
				const wrap = el('span', 'combo');
				const i = el('input');
				i.type = 'text';
				i.value = S[key] || '';
				i.setAttribute('list', 'dl-' + key);
				if (ph) i.placeholder = ph;
				const dl = el('datalist');
				dl.id = 'dl-' + key;
				list.forEach((v) => {
					const o = el('option');
					o.value = v;
					dl.appendChild(o);
				});
				i.addEventListener('input', () => {
					S[key] = i.value;
					renderSheet();
					syncURL();
				});
				wrap.appendChild(i);
				wrap.appendChild(dl);
				return wrap;
			}
			function numInput(key, min, max) {
				const i = el('input', 'num');
				i.type = 'number';
				i.min = String(min);
				i.max = String(max);
				i.value = String(S[key] ?? 0);
				i.addEventListener('input', () => {
					const v = Math.max(min, Math.min(max, parseInt(i.value || '0', 10)));
					S[key] = v;
					renderSheet();
					syncURL();
				});
				return i;
			}
			function checkList(items, isOn, onToggle, opts) {
				const box = el('div', 'checklist' + (opts && opts.compact ? ' compact' : ''));
				const variant = (opts && opts.variant) || '';
				items.forEach((it, idx) => {
					const on = isOn(idx);
					const row = el('label', 'check' + (variant && on ? ' ' + variant : ''));
					const cb = el('input');
					cb.type = 'checkbox';
					cb.checked = on;
					cb.addEventListener('change', () => {
						onToggle(idx, cb.checked);
						render();
					});
					row.appendChild(cb);
					const body = el('span', 'ctext');
					body.appendChild(el('b', null, it.name || ''));
					if (it.text) body.appendChild(el('span', 'cdesc', it.text));
					if (it.table) body.appendChild(tableNode(it.table));
					row.appendChild(body);
					box.appendChild(row);
				});
				return box;
			}
			function section(title, hint) {
				const d = el('details', 'step');
				d.open = true;
				const s = el('summary');
				s.appendChild(el('span', 'stitle', title));
				if (hint) s.appendChild(el('span', 'shint', hint));
				d.appendChild(s);
				return d;
			}

			// ========== 建立面板 ==========
			function renderBuilder() {
				const root = $('#builder');
				root.textContent = '';
				const pb = playbook();

				// 1. 扮演書
				{
					const d = section('1・原型扮演書', pb ? pb.name : '尚未選擇');
					const grid = el('div', 'pbgrid');
					RULES.playbooks.forEach((p) => {
						const b = el('button', 'pbcard' + (S.pb === p.name ? ' on' : ''));
						b.type = 'button';
						b.appendChild(el('b', null, p.name));
						b.appendChild(el('span', 'pbmove', p.signatureName));
						b.appendChild(el('span', 'pbdesc', p.intro.slice(0, 60)));
						b.addEventListener('click', () => {
							if (S.pb === p.name) return;
							const dirty = S.sig.length || S.advances.length || (S.bumps || []).length;
							if (dirty && !confirm('切換扮演書會清除招牌動作、屬性調整、成長紀錄與黑暗動作，確定要換嗎？')) return;
							S.pb = p.name;
							S.attrSet = 0;
							S.bumps = [];
							S.sig = [];
							S.advMoves = [];
							S.cons = [];
							// 以下都綁定原型扮演書，換書後必須一併清除
							S.advances = [];
							S.darkMoves = [];
							S.superForm = false;
							S.triumphForm = false;
							S.sigExtra = 0;
							render();
						});
						grid.appendChild(b);
					});
					d.appendChild(grid);
					root.appendChild(d);
				}
				if (!pb) return;

				// 2. 個人資料與變身
				{
					const d = section('2・個人資料與變身');
					const g = el('div', 'fgrid');
					g.appendChild(field('姓名', textInput('name')));
					g.appendChild(field('生活型態', textInput('life', '學生、打工族……')));
					g.appendChild(field('年齡', textInput('age')));
					g.appendChild(field('稱號', textInput('title', 'Star Melody Yuna')));
					g.appendChild(field('主題', comboInput('theme', OPTS.THEMES)));
					g.appendChild(field('色彩', comboInput('color', OPTS.COLORS)));
					g.appendChild(field('護符', comboInput('talisman', OPTS.TALISMANS)));
					g.appendChild(field('星座', comboInput('zodiac', OPTS.ZODIACS)));
					g.appendChild(field('血型', comboInput('blood', OPTS.BLOODS)));
					g.appendChild(field('最珍貴的寶物', textInput('treasure')));
					d.appendChild(g);
					root.appendChild(d);
				}

				// 3. 屬性
				{
					const a = pb.attributes;
					const d = section('3・屬性', a.mode === 'sets' ? '選擇一組並調整' : '基礎值加調整');
					if (a.mode === 'sets') {
						const row = el('div', 'setrow');
						a.sets.forEach((st, i) => {
							const b = el('button', 'setbtn' + (S.attrSet === i ? ' on' : ''));
							b.type = 'button';
							b.appendChild(el('b', null, st.label));
							b.appendChild(
								el('span', null, ATTRS.map((k) => k + ' ' + sign(st.values[k])).join('　'))
							);
							b.addEventListener('click', () => {
								S.attrSet = i;
								render();
							});
							row.appendChild(b);
						});
						d.appendChild(row);
					}
					if (a.note) d.appendChild(el('p', 'note', a.note));

					const fa = finalAttrs();
					const table = el('div', 'attrrow');
					ATTRS.forEach((k) => {
						const cell = el('div', 'attrcell');
						cell.appendChild(el('span', 'akey', k));
						cell.appendChild(el('b', 'aval', sign(fa[k])));
						const ctrl = el('div', 'actrl');
						[-1, 1].forEach((delta) => {
							const b = el('button', 'tiny');
							b.type = 'button';
							b.textContent = delta > 0 ? '＋' : '−';
							b.addEventListener('click', () => {
								S.bumps = S.bumps || [];
								S.bumps.push({ k, d: delta });
								render();
							});
							ctrl.appendChild(b);
						});
						cell.appendChild(ctrl);
						table.appendChild(cell);
					});
					d.appendChild(table);

					if ((S.bumps || []).length) {
						const chips = el('div', 'chips');
						S.bumps.forEach((b, i) => {
							const c = el('button', 'chip');
							c.type = 'button';
							c.textContent = b.k + ' ' + sign(b.d) + ' ✕';
							c.title = '移除這項調整';
							c.addEventListener('click', () => {
								S.bumps.splice(i, 1);
								render();
							});
							chips.appendChild(c);
