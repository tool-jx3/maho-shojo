---
// ============================================
// 角色卡建立頁（純前端，無後端）
// 規則資料由 scripts/extract_rules.py 從 rules/*.md 抽出至 src/data/rules.json
// ============================================
import rules from '../data/rules.json';

const THEMES = ['動物', '鎖鏈', '夢境', '大地', '水', '火', '空氣', '木', '金屬', '時間', '卡牌', '心形', '花朵', '劍', '自然', '光', '黑暗', '月亮', '彩虹', '布料', '星星', '太陽', '音樂'];
const COLORS = ['紅色', '橘色', '黃色', '綠色', '藍色', '紫色', '粉紅色', '白色', '棕色', '灰色', '金色', '銀色', '黑色'];
const TALISMANS = ['耳環', '戒指', '胸針', '手錶', '手環', '香水', '魔法棒', '寶石', '手機'];
const ZODIACS = ['牡羊座', '金牛座', '雙子座', '巨蟹座', '獅子座', '處女座', '天秤座', '天蠍座', '射手座', '摩羯座', '水瓶座', '雙魚座'];
const BLOODS = ['A 型', 'B 型', 'AB 型', 'O 型'];
const HEART_CATS = [
	{ key: 'A', label: '攻擊（A）' },
	{ key: 'D', label: '防禦（D）' },
	{ key: 'P', label: '支援（P）' },
	{ key: 'F', label: '終曲' },
];

const OPTIONS = { THEMES, COLORS, TALISMANS, ZODIACS, BLOODS, HEART_CATS };
---

<html lang="zh-TW">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>魔法少女──角色卡建立</title>
		<meta name="description" content="Mahō Shōjo 魔法少女 TRPG 角色卡建立工具——選擇扮演書與盟約，即時預覽並列印 A4 角色卡，支援 JSON 與網址分享。" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta name="theme-color" content="#12102a" />
		<meta property="og:title" content="魔法少女──角色卡建立" />
		<meta property="og:description" content="選擇扮演書與盟約，即時預覽並列印 A4 角色卡，支援 JSON 與網址分享。" />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/og-image.jpg" />
	</head>
	<body>
		<script type="application/json" id="rules-data" set:html={JSON.stringify(rules)}></script>
		<script type="application/json" id="opts-data" set:html={JSON.stringify(OPTIONS)}></script>

		<header class="topbar no-print">
			<div class="brand">
				<a class="home" href="/" title="回到文件站">✦</a>
				<h1>角色卡建立</h1>
				<span class="sub">Mahō Shōjo・魔法少女</span>
			</div>
			<div class="tools">
				<button type="button" id="btn-import">匯入 JSON</button>
				<button type="button" id="btn-export">匯出 JSON</button>
				<button type="button" id="btn-share">複製分享網址</button>
				<button type="button" id="btn-print" class="primary">列印／PDF</button>
				<button type="button" id="btn-reset" class="ghost">重設</button>
				<input type="file" id="file-input" accept="application/json,.json" hidden />
			</div>
		</header>

		<p class="toast no-print" id="toast" role="status" aria-live="polite"></p>

		<main class="wrap">
			<section class="builder no-print" id="builder" aria-label="建立步驟"></section>
			<section class="preview" aria-label="角色卡預覽">
				<div class="sheet" id="sheet"></div>
			</section>
		</main>

		<footer class="foot no-print">
			<span>資料只存在你的瀏覽器與網址中，不會上傳任何伺服器。</span>
			<a href="/rules/character-creation/">角色建立規則 →</a>
		</footer>

		<script>
			// ========== 資料載入 ==========
			const RULES = JSON.parse(document.getElementById('rules-data').textContent);
			const OPTS = JSON.parse(document.getElementById('opts-data').textContent);
			const ATTRS = RULES.attributeKeys;
			const $ = (s, r) => (r || document).querySelector(s);
			// 規則內文是 Markdown，顯示前去掉粗體記號與連結語法
			const clean = (t) =>
				String(t || '').replace(/\*\*/g, '').replace(/\[(.+?)\]\(.+?\)/g, '$1');
			const el = (tag, cls, txt) => {
				const n = document.createElement(tag);
				if (cls) n.className = cls;
				if (txt != null) n.textContent = txt;
				return n;
			};
			const sign = (n) => (n > 0 ? '+' + n : String(n));

			// ========== 狀態 ==========
			const BLANK = {
				v: 1, pb: '', name: '', life: '', age: '',
				title: '', theme: '', color: '', talisman: '', zodiac: '', blood: '', treasure: '',
				attrSet: 0, bumps: [], sig: [],
				pact: '', pactMoves: [], pactAdv: [], darkMoves: [], lostCoop: [],
				fr: '', frMoves: [], rom: '', romMoves: [],
				power: 1, superForm: false, triumphForm: false, sigExtra: 0,
				powerPick: {}, powerOn: [], ascension: {}, attrPick: {}, attrPlan: '', freeAttr: false,
				hearts: [{ name: '', cat: 'A', effect: '' }],
				advMoves: [], shine: 0, players: 4, advances: [],
				light: 0, tenebrae: 0, dark: 0, darkLv: 0, amity: 5, romLv: 0, impetus: 0, popularity: 0,
				cons: [], bonds: '', notes: '',
			};
			let S = structuredClone(BLANK);
			let ADV_OPEN = []; // 成長卡的展開狀態，僅存在於瀏覽期間，不寫入存檔或網址
			const STEP_OPEN = {}; // 各建立步驟的展開狀態，重繪時要保留

			const playbook = () => RULES.playbooks.find((p) => p.name === S.pb) || null;
			const pact = () => RULES.pacts.find((p) => p.name === S.pact) || null;
			const frBook = () => RULES.friendship.find((p) => p.name === S.fr) || null;
			const romBook = () => RULES.romance.find((p) => p.name === S.rom) || null;

			// 依扮演書計算最終屬性（基礎／組合 + 加值）
			// 建立時的分配規則（各扮演書的屬性說明）：判斷這一次加減是否被規則允許
			// points   ── 可分配的 +1 點數（聖母限保護／思慮／情感）
			// zeroSwap ── 一個 0 改 +1，另一個 0 改 -1（鬥士）
			// spread   ── 先選一種分配方式，再依該方式配點（偶像）
			function adjustBlockReason(adj, k, delta, parts, free) {
				const pt = parts[k];
				const next = pt.base + pt.manual + delta;
				if (next > 2 || next < -2) return '建立時任何屬性不得高於 +2 或低於 -2';
				if (free) return '';
				const plus = ATTRS.reduce((n, x) => n + Math.max(parts[x].manual, 0), 0);
				const minus = ATTRS.reduce((n, x) => n + Math.min(parts[x].manual, 0), 0);
				if (adj.mode === 'points') {
					if (delta < 0) return '這本扮演書只能加點，不能扣點';
					if (adj.only && adj.only.indexOf(k) < 0) return '只能加在' + adj.only.join('、') + '上';
					if (plus >= adj.total) return '可分配的點數已用完（共 ' + adj.total + ' 點）';
					return '';
				}
				if (adj.mode === 'zeroSwap') {
					if (pt.base !== 0) return '只能調整基礎值為 0 的屬性';
					if (pt.manual !== 0) return '這項屬性已經調整過了';
					if (delta > 0 && plus >= 1) return '只能有一項 0 改為 +1';
					if (delta < 0 && minus <= -1) return '只能有一項 0 改為 -1';
					return '';
				}
				if (adj.mode === 'spread') {
					if (delta < 0) return '這本扮演書只能加點，不能扣點';
					const plan = (adj.options || []).find((o) => o.join('/') === S.attrPlan);
					if (!plan) return '請先選擇一種分配方式';
					if (pt.base + pt.manual + delta > (adj.cap ?? 2))
						return '任一屬性上限為 +' + (adj.cap ?? 2);
					// 已分配的各項加值必須符合所選方式
					const used = ATTRS.map((x) => parts[x].manual).filter((v) => v > 0).sort((x, y) => y - x);
					const after = ATTRS.map((x) => (x === k ? parts[x].manual + delta : parts[x].manual))
						.filter((v) => v > 0)
						.sort((x, y) => y - x);
					const want = plan.slice().sort((x, y) => y - x);
					if (after.length > want.length) return '這種分配方式只能加在 ' + want.length + ' 項屬性上';
					for (let i = 0; i < after.length; i++) {
						if (after[i] > want[i]) return '這種分配方式的配額為 ' + want.join('、');
					}
					if (used.length && after.join() === used.join()) return '';
					return '';
				}
				return '';
			}

			// 屬性的組成：扮演書基礎值、建立時的調整、成長、永久提升屬性的黑暗動作。
			// 昇華不在其中——規則寫的是「所有使用該屬性的動作獲得 +1 加值」，是擲骰加值而非屬性值。
			function attrParts() {
				const pb = playbook();
				const out = {};
				ATTRS.forEach((k) => (out[k] = { base: 0, manual: 0, adv: 0, dark: 0, darkFrom: [], cap: null }));
				if (!pb) return out;
				const a = pb.attributes;
				const base = a.mode === 'sets' ? (a.sets[S.attrSet] || a.sets[0]).values : a.values;
				ATTRS.forEach((k) => (out[k].base = base[k] ?? 0));
				(S.bumps || []).forEach((b) => {
					if (!out[b.k]) return;
					if (b.fromAdv) out[b.k].adv += b.d;
					else out[b.k].manual += b.d;
				});
				// 永久提升屬性的黑暗動作（契約傀儡「黑暗印記」「非人意識」）
				const pc = pact();
				const dm = pc ? (pc.darkMoves || {})[S.pb] || [] : [];
				(S.darkMoves || []).forEach((i) => {
					const m = dm[i];
					if (!m || !m.attrGrant) return;
					const g = m.attrGrant;
					const key = g.mode === 'fixed' ? g.key : (S.attrPick || {})[m.name];
					if (!key || !out[key]) return;
					out[key].dark += g.value;
					out[key].darkFrom.push(m.name);
					out[key].cap = out[key].cap == null ? g.max : Math.max(out[key].cap, g.max);
				});
				ATTRS.forEach((k) => {
					const p = out[k];
					p.total = p.base + p.manual + p.adv + p.dark;
					if (p.cap != null && p.total > p.cap) {
						p.dark -= p.total - p.cap; // 這類動作明訂上限，超過的部分不生效
						p.total = p.cap;
					}
				});
				return out;
			}
			function finalAttrs() {
				const parts = attrParts();
				const out = {};
				ATTRS.forEach((k) => (out[k] = parts[k].total));
				return out;
			}

			// 能力量表：規則「如果光點數量超過目前的能力量表等級，則將量表提升至與當前光點數量相等」
			// （量表在場景中不會下降，所以只往上提；被黑暗女神取代時改用暗點計算）
			function syncPowerLevel() {
				const driver = luxView().replace ? S.tenebrae || 0 : S.light || 0;
				const target = Math.min(5, driver);
				if (target > (S.power || 0)) S.power = target;
			}

			// 依「已完成」的成長紀錄套用效果：屬性、動作、形態、招牌額外選項
			function applyAdvances() {
				const pb = playbook();
				if (!pb) return;
				S.bumps = (S.bumps || []).filter((b) => !b.fromAdv);
				S.advMoves = [];
				S.superForm = false;
				S.triumphForm = false;
				S.sigExtra = 0;
				S.advances.forEach((a) => {
					if (!a.done || !a.opt) return;
					if (a.opt.indexOf('提升一項屬性') >= 0 && a.detail) {
						S.bumps.push({ k: a.detail, d: 1, fromAdv: true });
					} else if (a.opt.indexOf('進階動作') >= 0 && a.detail !== '') {
						const i = parseInt(a.detail, 10);
						if (!isNaN(i) && !S.advMoves.includes(i)) S.advMoves.push(i);
					} else if (a.opt.indexOf('友情扮演書動作') >= 0) {
						/* 友情動作由 advGrantedFr() 併入，不寫回 S.frMoves */
					} else if (a.detail === 'super') {
						S.superForm = true;
					} else if (a.detail === 'triumph') {
						S.superForm = true;
						S.triumphForm = true;
					} else if (a.detail === 'sig3') {
						S.sigExtra += 3;
					}
				});
			}

			// ========== 網址序列化（純前端，無後端） ==========
			const b64e = (bytes) => {
				let s = '';
				bytes.forEach((b) => (s += String.fromCharCode(b)));
				return btoa(s).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
			};
			const b64d = (str) => {
				const s = atob(str.replace(/-/g, '+').replace(/_/g, '/'));
				const out = new Uint8Array(s.length);
				for (let i = 0; i < s.length; i++) out[i] = s.charCodeAt(i);
				return out;
			};
			async function encodeState() {
				const json = JSON.stringify(S);
				const raw = new TextEncoder().encode(json);
				if (typeof CompressionStream === 'function') {
					const cs = new CompressionStream('deflate-raw');
					const buf = await new Response(
						new Blob([raw]).stream().pipeThrough(cs)
					).arrayBuffer();
					return 'z' + b64e(new Uint8Array(buf));
				}
				return 'p' + b64e(raw);
			}
			async function decodeState(str) {
				const kind = str[0];
				const bytes = b64d(str.slice(1));
				let raw = bytes;
				if (kind === 'z') {
					const ds = new DecompressionStream('deflate-raw');
					const buf = await new Response(
						new Blob([bytes]).stream().pipeThrough(ds)
					).arrayBuffer();
					raw = new Uint8Array(buf);
				}
				return JSON.parse(new TextDecoder().decode(raw));
			}

			let urlTimer = null;
			function syncURL() {
				clearTimeout(urlTimer);
				urlTimer = setTimeout(async () => {
					try {
						const code = await encodeState();
						history.replaceState(null, '', '#c=' + code);
					} catch (e) {
						/* 忽略：網址同步失敗不影響編輯 */
					}
				}, 300);
			}

			function toast(msg) {
				const t = $('#toast');
				t.textContent = msg;
				t.classList.add('show');
				setTimeout(() => t.classList.remove('show'), 2400);
			}

			// 由規則資料的 table 欄位建出真正的表格
			function tableNode(t, cls) {
				const tb = el('table', cls || 'minitable');
				const th = el('thead');
				const htr = el('tr');
				t.headers.forEach((h) => htr.appendChild(el('th', null, h)));
				th.appendChild(htr);
				tb.appendChild(th);
				const body = el('tbody');
				t.rows.forEach((r) => {
					const tr = el('tr');
					r.forEach((c) => tr.appendChild(el('td', null, c)));
					body.appendChild(tr);
				});
				tb.appendChild(body);
				return tb;
			}

			// 官方扮演書上每項成長前方的欄位數（可重複選取的次數）；基礎成長與進階成長各自獨立計算
			function advBoxUsed(text, isAdvanced, skipIdx) {
				let n = 0;
				S.advances.forEach((x, i) => {
					if (i === skipIdx) return;
					if ((i >= 5) !== isAdvanced) return;
					if (x.opt && x.opt === text) n++;
				});
				return n;
			}
			// 以 CSS 方框呈現欄位／勾選狀態，實心與空心大小一致
			function boxRow(total, used) {
				const w = el('span', 'boxrow');
				for (let i = 0; i < total; i++) w.appendChild(el('i', 'bx' + (i < used ? ' on' : '')));
				return w;
			}

			const doneAdvCount = () => S.advances.filter((a) => a.done).length;
			// 偶像人氣值上限：一般為 1，取得「登上舞台……Let's go」MAX+ 成長後為 3
			const popularityMax = () =>
				S.advances.some((a) => a.done && a.opt && a.opt.indexOf('MAX+') >= 0) ? 3 : 1;
			// 盟約動作／盟約優勢：建立時 1 項，第六次成長再 1 項
			const pactPickLimit = () => (doneAdvCount() >= 6 ? 2 : 1);
			// 友情動作：建立時 1 個；光明子女盟約動作「友情是世界上最珍貴的寶物」再 +1
			function frPickLimit() {
				const pc = pact();
				if (!pc) return 1;
				const bonus = (S.pactMoves || []).some(
					(i) => ((pc.moves || [])[i] || {}).name === '友情是世界上最珍貴的寶物'
				);
				return bonus ? 2 : 1;
			}

			// 刪除中間的成長後，後面的成長會往前遞補而改變「第幾次」，
			// 進而改變基礎／進階分類、超級形態的前置條件與欄位用量。
			// 這裡重新檢查每一筆，不再合法的就清空該次成長讓使用者重選。
			function revalidateAdvances() {
				const pb = playbook();
				if (!pb) return [];
				const usedCount = {};
				const cleared = [];
				S.advances.forEach((a, i) => {
					if (!a.opt) return;
					const isAdvanced = i >= 5;
					const pool = advPool(isAdvanced);
					const meta = pool.find((o) => o.text === a.opt);
					const key = (isAdvanced ? 'a:' : 'b:') + a.opt;
					usedCount[key] = (usedCount[key] || 0) + 1;
					const bad = !meta || !!advBlockReason(a.opt, i) || usedCount[key] > meta.boxes;
					if (bad) {
						cleared.push('第 ' + (i + 1) + ' 次「' + a.opt + '」');
						usedCount[key]--;
						a.opt = '';
						a.detail = '';
						a.done = false;
					}
				});
				return cleared;
			}

			// 某一形態是否已由其他成長取得
			const formTaken = (kind, idx, before) =>
				S.advances.some((x, i) => i !== idx && (!before || i < idx) && x.done && x.detail === kind);

			// 成長的前置條件（規則「成長類型」）：不符合時該項成長不可選擇
			function advBlockReason(text, idx) {
				if (text.indexOf('超級形態') >= 0) {
					if (idx < 2) return '需先取得 2 次成長';
					if (formTaken('super', idx)) return '已取得超級形態';
				}
				if (text.indexOf('凱旋形態') >= 0) {
					if (!formTaken('super', idx, true)) return '需先取得超級形態';
					if (formTaken('triumph', idx)) return '已取得凱旋形態';
				}
				return '';
			}

			// 可選的成長清單。規則明訂「解鎖超級形態」是例外，也可以作為進階成長選擇。
			function advPool(isAdvanced) {
				const pb = playbook();
				if (!pb) return [];
				if (!isAdvanced) return pb.basicAdvances;
				const sup = pb.basicAdvances.find((o) => o.text.indexOf('超級形態') >= 0);
				return sup ? pb.advancedAdvances.concat([sup]) : pb.advancedAdvances;
			}

			// 成長欄位總覽：對應官方扮演書上每項成長前方的 ○
			function advBoxTable(cls) {
				const pb = playbook();
				const wrap = el('div', cls || 'advboxes');
				[
					['基礎成長', pb.basicAdvances, false],
					['進階成長', pb.advancedAdvances, true],
				].forEach(([label, pool, isAdvanced]) => {
					const col = el('div', 'advboxcol');
					col.appendChild(el('b', null, label));
					const ul = el('ul', 'advboxlist');
					pool.forEach((o) => {
						const used = advBoxUsed(o.text, isAdvanced, -1);
						const li = el('li', used >= o.boxes ? 'full' : null);
						li.appendChild(boxRow(o.boxes, used));
						li.appendChild(el('span', null, clean(o.text)));
						ul.appendChild(li);
					});
					col.appendChild(ul);
					wrap.appendChild(col);
				});
				return wrap;
			}

			// 由成長取得的友情動作（與手動勾選分開，避免互相覆蓋）
			function advGrantedFr() {
				const out = [];
				S.advances.forEach((a) => {
					if (a.done && a.opt && a.opt.indexOf('友情扮演書動作') >= 0 && a.detail !== '') {
						const i = parseInt(a.detail, 10);
						if (!isNaN(i) && !out.includes(i)) out.push(i);
					}
				});
				return out;
			}
			const effFrMoves = () => {
				const g = advGrantedFr();
				return (S.frMoves || []).concat(g.filter((i) => !(S.frMoves || []).includes(i)));
			};

			// 目前生效的能力量表：可能被盟約優勢／黑暗動作取代，或多一個額外形態
			function luxView() {
				const pb = playbook();
				const pc = pact();
				let replace = null;
				let extra = null;
				if (pc) {
					const picked = []
						.concat((pc.advantages || []).filter((a, i) => (S.pactAdv || []).includes(i)))
						.concat((pc.moves || []).filter((m, i) => (S.pactMoves || []).includes(i)))
						.concat(((pc.darkMoves || {})[S.pb] || []).filter((m, i) => (S.darkMoves || []).includes(i)));
					picked.forEach((m) => {
						if (m.tableKind === 'replaceLux' && !replace) replace = m;
						if (m.tableKind === 'extraForm' && !extra) extra = m;
					});
				}
				return { rows: pb ? pb.lux : [], replace, extra };
			}

			// 已標記後果造成的屬性懲罰（每項 -2）
			function consPenalty() {
				const pb = playbook();
				const out = {};
				if (!pb) return out;
				const all = pb.consequences.concat(['落敗']);
				(S.cons || []).forEach((i) => {
					const info = (RULES.consequenceInfo || {})[all[i]] || {};
					if (info.attribute) out[info.attribute] = (out[info.attribute] || 0) - 2;
				});
				return out;
			}

			// 已選項目中、能力量表以外的力量加值來源
			// fixed = 變身後持續生效；choice = 需擇一；conditional = 需花費資源或依情境成立
			function grantSources() {
				const pb = playbook();
				const pc = pact();
				const out = [];
				const push = (from, list, idxs) => {
					(list || []).forEach((m, i) => {
						if (idxs && !idxs.includes(i)) return;
						if (m && m.powerGrants) out.push({ from, name: m.name, g: m.powerGrants });
					});
				};
				if (pb) {
					const sg = pb.signature;
					push(pb.signatureName, sg.granted);
					push(pb.signatureName, sg.mode === 'options' ? sg.options : sg.chooseFrom, S.sig);
					push(pb.name + '進階動作', pb.advanceMoves, S.advMoves);
				}
				if (pc) {
					push(pc.name + '盟約優勢', pc.advantages, S.pactAdv || []);
					push(pc.name + '盟約動作', pc.moves, S.pactMoves || []);
					push(S.pb + '黑暗動作', (pc.darkMoves || {})[S.pb] || [], S.darkMoves || []);
				}
				const fb = frBook();
				if (fb) push('友情・' + fb.name, fb.moves, effFrMoves());
				const rb = romBook();
				if (rb) push('戀愛・' + rb.name, rb.moves);
				return out;
			}

			// 目前解鎖的光之裝束力量總和
			// 規則：能力量表上「該等級及以下」的所有力量都可使用，且各形態與各等級的力量累加
			const POWER_KEYS = ['護甲', '昇華', '摧毀', '懲罰', '堅韌'];
			function luxPowers() {
				const lv = luxView();
				// 規則（懲戒黑暗）：「變身後的玩家角色基礎造成的懲罰點數和摧毀點數為：懲罰/1 和摧毀/0」
				const sum = { 護甲: 0, 昇華: 0, 摧毀: 0, 懲罰: 1, 堅韌: 0 };
				const hearts = [];
				let finalem = false;
				const take = (cell) => {
					const t = String(cell || '').trim();
					if (!t || t === '—') return;
					if (t.indexOf('終曲') >= 0) {
						finalem = true;
						return;
					}
					if (t.indexOf('心之力') >= 0) {
						const m = t.match(/心之力\s*[（(]?\s*([ADP])?/);
						hearts.push(m && m[1] ? m[1] : '自選');
						return;
					}
					const m = t.match(/(護甲|昇華|摧毀|懲罰|堅韌)\s*\+(\d+)/);
					if (m) sum[m[1]] += parseInt(m[2], 10);
				};
				const forms = [true, !!S.superForm, !!S.triumphForm];
				if (lv.replace) {
					lv.replace.table.rows.forEach((r) => {
						const level = parseInt(r[0], 10);
						if (isNaN(level) || level > S.power) return;
						for (let c = 1; c < r.length; c++) if (forms[c - 1]) take(r[c]);
					});
				} else {
					lv.rows.forEach((r) => {
						if (r.level > S.power) return;
						[r.basic, r.super, r.triumph].forEach((cell, i) => forms[i] && take(cell));
					});
				}
				// 盟約優勢帶來的額外形態（例如契約傀儡「契約形態」）同樣累加
				if (lv.extra) {
					(lv.extra.formTable || []).forEach((r) => {
						if (r.level <= S.power) take(r.effect);
					});
				}
				// 量表以外的加值
				const extras = [];
				grantSources().forEach((src) => {
					const add = (k, v) => {
						sum[k] += v;
						extras.push({ name: src.name, key: k, value: v });
					};
					if (src.g.mode === 'fixed') src.g.items.forEach((it) => add(it.key, it.value));
					else if (src.g.mode === 'choice') {
						const pick = (S.powerPick || {})[src.name];
						const it = src.g.items.find((x) => x.key === pick);
						if (it) add(it.key, it.value);
					} else if ((S.powerOn || []).includes(src.name)) {
						const pick = (S.powerPick || {})[src.name];
						const list = pick ? src.g.items.filter((x) => x.key === pick) : src.g.items;
						list.forEach((it) => add(it.key, it.value));
					}
				});
				return { sum, hearts, finalem, extras };
			}

			// 目前力量數值一覽（建立面板與角色卡共用）
			// 五項力量比照屬性的方格呈現，心之力與終曲只在有內容時以小標籤列出
			function powerSummary(sheet) {
				const pw = luxPowers();
				const wrap = el('div', sheet ? 'pwwrap sheet' : 'pwwrap');
				const row = el('div', sheet ? 'sattrs pw' : 'attrrow pw');
				POWER_KEYS.forEach((k) => {
					const on = !!pw.sum[k];
					const c = el('div', (sheet ? 'sattr' : 'attrcell') + (on ? '' : ' off'));
					c.appendChild(el('span', sheet ? null : 'akey', k));
					c.appendChild(el('b', sheet ? null : 'aval', on ? '+' + pw.sum[k] : '—'));
					row.appendChild(c);
				});
				wrap.appendChild(row);
				const tags = el('div', 'pwtags');
				if (pw.hearts.length) tags.appendChild(el('span', 'pill', '心之力 ' + pw.hearts.join('／')));
				if (pw.finalem) tags.appendChild(el('span', 'pill', '終曲可用'));
				if (!pw.hearts.length && !pw.finalem) tags.appendChild(el('span', 'pill off', '尚未解鎖心之力與終曲'));
				wrap.appendChild(tags);
				return wrap;
			}

			// ========== 小工具：建立表單控制項 ==========
			function field(label, node) {
				const w = el('label', 'field');
				w.appendChild(el('span', 'flabel', label));
				w.appendChild(node);
				return w;
			}
			function textInput(key, ph) {
				const i = el('input');
				i.type = 'text';
				i.value = S[key] || '';
				if (ph) i.placeholder = ph;
				i.addEventListener('input', () => {
					S[key] = i.value;
					renderSheet();
					syncURL();
				});
				return i;
			}
			function comboInput(key, list, ph) {
				const wrap = el('span', 'combo');
				const i = el('input');
				i.type = 'text';
				i.value = S[key] || '';
				i.setAttribute('list', 'dl-' + key);
				if (ph) i.placeholder = ph;
				const dl = el('datalist');
				dl.id = 'dl-' + key;
				list.forEach((v) => {
					const o = el('option');
					o.value = v;
					dl.appendChild(o);
				});
				i.addEventListener('input', () => {
					S[key] = i.value;
					renderSheet();
					syncURL();
				});
				wrap.appendChild(i);
				wrap.appendChild(dl);
				return wrap;
			}
			// 這些數值會影響建立面板本身（力量加總、黑暗動作名額、後果懲罰……），
			// 因此改動後要整個重繪，並把焦點還給原本的欄位。
			function numInput(key, min, max) {
				const i = el('input', 'num');
				i.type = 'number';
				i.min = String(min);
				i.max = String(max);
				i.value = String(S[key] ?? 0);
				i.dataset.numkey = key;
				i.addEventListener('input', () => {
					const v = Math.max(min, Math.min(max, parseInt(i.value || '0', 10)));
					S[key] = v;
					render();
					const back = document.querySelector('[data-numkey="' + key + '"]');
					if (back) back.focus();
				});
				return i;
			}
			function checkList(items, isOn, onToggle, opts) {
				const box = el('div', 'checklist' + (opts && opts.compact ? ' compact' : ''));
				const variant = (opts && opts.variant) || '';
				items.forEach((it, idx) => {
					const on = isOn(idx);
					const row = el('label', 'check' + (variant && on ? ' ' + variant : ''));
					const cb = el('input');
					cb.type = 'checkbox';
					cb.checked = on;
					cb.addEventListener('change', () => {
						onToggle(idx, cb.checked);
						render();
					});
					row.appendChild(cb);
					const body = el('span', 'ctext');
					body.appendChild(el('b', null, it.name || ''));
					if (it.text) body.appendChild(el('span', 'cdesc', clean(it.text)));
					if (it.table) body.appendChild(tableNode(it.table));
					row.appendChild(body);
					box.appendChild(row);
				});
				return box;
			}
			function section(title, hint) {
				const d = el('details', 'step');
				const key = title.split('・')[0];
				d.open = STEP_OPEN[key] !== false;
				d.addEventListener('toggle', () => {
					STEP_OPEN[key] = d.open;
				});
				const s = el('summary');
				s.appendChild(el('span', 'stitle', title));
				if (hint) s.appendChild(el('span', 'shint', hint));
				d.appendChild(s);
				return d;
			}

			// ========== 建立面板 ==========
			function renderBuilder() {
				const root = $('#builder');
				root.textContent = '';
				const pb = playbook();

				// 1. 扮演書
				{
					const d = section('1・原型扮演書', pb ? pb.name : '尚未選擇');
					const grid = el('div', 'pbgrid');
					RULES.playbooks.forEach((p) => {
						const b = el('button', 'pbcard' + (S.pb === p.name ? ' on' : ''));
						b.type = 'button';
						b.appendChild(el('b', null, p.name));
						b.appendChild(el('span', 'pbmove', p.signatureName));
						b.appendChild(el('span', 'pbdesc', p.intro.slice(0, 60)));
						b.addEventListener('click', () => {
							if (S.pb === p.name) return;
							const dirty = S.sig.length || S.advances.length || (S.bumps || []).length;
							if (dirty && !confirm('切換扮演書會清除招牌動作、屬性調整、成長紀錄與黑暗動作，確定要換嗎？')) return;
							S.pb = p.name;
							S.attrSet = 0;
							S.bumps = [];
							S.sig = [];
							S.advMoves = [];
							S.cons = [];
							// 以下都綁定原型扮演書，換書後必須一併清除
							S.advances = [];
							ADV_OPEN = [];
							S.darkMoves = [];
							S.superForm = false;
							S.triumphForm = false;
							S.sigExtra = 0;
							render();
						});
						grid.appendChild(b);
					});
					d.appendChild(grid);
					root.appendChild(d);
				}
				if (!pb) return;

				// 2. 個人資料與變身
				{
					const d = section('2・個人資料與變身');
					const g = el('div', 'fgrid');
					g.appendChild(field('姓名', textInput('name')));
					g.appendChild(field('生活型態', textInput('life', '學生、打工族……')));
					g.appendChild(field('年齡', textInput('age')));
					g.appendChild(field('稱號', textInput('title', 'Star Melody Yuna')));
					g.appendChild(field('主題', comboInput('theme', OPTS.THEMES)));
					g.appendChild(field('色彩', comboInput('color', OPTS.COLORS)));
					g.appendChild(field('護符', comboInput('talisman', OPTS.TALISMANS)));
					g.appendChild(field('星座', comboInput('zodiac', OPTS.ZODIACS)));
					g.appendChild(field('血型', comboInput('blood', OPTS.BLOODS)));
					g.appendChild(field('最珍貴的寶物', textInput('treasure')));
					d.appendChild(g);
					root.appendChild(d);
				}

				// 3. 屬性
				{
					const a = pb.attributes;
					const d = section('3・屬性', a.mode === 'sets' ? '選擇一組並調整' : '基礎值加調整');
					if (a.mode === 'sets') {
						const row = el('div', 'setrow');
						a.sets.forEach((st, i) => {
							const b = el('button', 'setbtn' + (S.attrSet === i ? ' on' : ''));
							b.type = 'button';
							b.appendChild(el('b', null, st.label));
							b.appendChild(
								el('span', null, ATTRS.map((k) => k + ' ' + sign(st.values[k])).join('　'))
							);
							b.addEventListener('click', () => {
								S.attrSet = i;
								render();
							});
							row.appendChild(b);
						});
						d.appendChild(row);
					}
					if (a.note) d.appendChild(el('p', 'note', a.note));

					const parts = attrParts();
					const asc = S.ascension || {};
					const adj = a.adjust; // 這本扮演書的建立分配規則（沒有就不限制）
					const free = !adj || S.freeAttr;

					// 偶像：先選一種分配方式
					if (adj && adj.mode === 'spread' && !S.freeAttr) {
						const row = el('div', 'pactrow');
						adj.options.forEach((o) => {
							const key = o.join('/');
							const on = S.attrPlan === key;
							const b = el('button', 'pactbtn' + (on ? ' on' : ''));
							b.type = 'button';
							b.textContent = o.map((v) => '+' + v).join(' 和 ') + (o.length > 1 ? '（' + o.length + ' 項）' : '（1 項）');
							b.addEventListener('click', () => {
								if (!on) {
									S.attrPlan = key;
									S.bumps = (S.bumps || []).filter((x) => x.fromAdv); // 換方式時清掉已配的點
								} else S.attrPlan = '';
								render();
							});
							row.appendChild(b);
						});
						d.appendChild(row);
					}

					// 目前的分配狀況
					if (adj && !S.freeAttr) {
						const plus = ATTRS.reduce((n, x) => n + Math.max(parts[x].manual, 0), 0);
						const minus = ATTRS.reduce((n, x) => n + Math.min(parts[x].manual, 0), 0);
						let txt = '';
						if (adj.mode === 'points') txt = '已分配 ' + plus + ' / ' + adj.total + ' 點';
						else if (adj.mode === 'zeroSwap')
							txt = '0 改為 +1：' + (plus ? '已指定' : '未指定') + '　0 改為 -1：' + (minus ? '已指定' : '未指定');
						else if (adj.mode === 'spread')
							txt = S.attrPlan ? '分配方式 ' + S.attrPlan.split('/').map((v) => '+' + v).join('、') + '　已分配 ' + plus + ' 點' : '尚未選擇分配方式';
						d.appendChild(el('p', 'note' + (txt.indexOf('未') < 0 ? ' ok' : ''), txt));
					}

					const table = el('div', 'attrrow');
					ATTRS.forEach((k) => {
						const pt = parts[k];
						const cell = el('div', 'attrcell');
						cell.appendChild(el('span', 'akey', k));
						cell.appendChild(el('b', 'aval', sign(pt.total)));
						// 非按鈕來源的加值：標示顏色與來源
						const src = el('div', 'asrc');
						if (pt.adv) src.appendChild(el('span', 'tag adv', '成長 ' + sign(pt.adv)));
						if (pt.dark) src.appendChild(el('span', 'tag dark', pt.darkFrom.join('、') + ' ' + sign(pt.dark)));
						if (asc[k]) src.appendChild(el('span', 'tag asc', '昇華 +' + asc[k] + '（擲骰）'));
						if (src.childNodes.length) cell.appendChild(src);
						// 建立時的調整不得讓屬性超出 -2 ～ +2；成長與黑暗動作的加值另計
						const ctrl = el('div', 'actrl');
						[-1, 1].forEach((delta) => {
							const next = pt.base + pt.manual + delta;
							const undo = (S.bumps || []).some((b) => b.k === k && !b.fromAdv && b.d === delta * -1);
							const reason = undo ? '' : adjustBlockReason(adj, k, delta, parts, free);
							const blocked = !undo && !!reason;
							const b = el('button', 'tiny');
							b.type = 'button';
							b.disabled = blocked;
							b.title = blocked ? reason : undo ? '取消一項已加的 ' + k + ' ' + sign(delta * -1) : '';
							b.textContent = delta > 0 ? '＋' : '−';
							b.addEventListener('click', () => {
								S.bumps = S.bumps || [];
								// 先抵銷反向的調整，沒有的話才新增一筆
								const i = S.bumps.findIndex((x) => x.k === k && !x.fromAdv && x.d === delta * -1);
								if (i >= 0) S.bumps.splice(i, 1);
								else S.bumps.push({ k, d: delta });
								render();
							});
							ctrl.appendChild(b);
						});
						cell.appendChild(ctrl);
						table.appendChild(cell);
					});
					d.appendChild(table);

					{
						const lab = el('label', 'check inline');
						const cb = el('input');
						cb.type = 'checkbox';
						cb.checked = !!S.freeAttr;
						cb.addEventListener('change', () => {
							S.freeAttr = cb.checked;
							render();
						});
						lab.appendChild(cb);
						lab.appendChild(el('span', null, '自由調整（編輯遊戲中的角色時使用，僅保留 -2 ～ +2 的建立限制）'));
						d.appendChild(lab);
					}

					const manualBumps = (S.bumps || []).map((b, i) => ({ b, i })).filter((x) => !x.b.fromAdv);
					if (manualBumps.length) {
						d.appendChild(el('p', 'note dim', '建立時的調整（點擊可移除）'));
						const chips = el('div', 'chips');
						manualBumps.forEach(({ b, i }) => {
							const c = el('button', 'chip');
							c.type = 'button';
							c.textContent = b.k + ' ' + sign(b.d) + ' ✕';
							c.title = '移除這項調整';
							c.addEventListener('click', () => {
								S.bumps.splice(i, 1);
								render();
							});
							chips.appendChild(c);
						});
						d.appendChild(chips);
					}
					d.appendChild(
						el('p', 'note dim',
							'加減按鈕依這本扮演書的分配規則限制，超出時會停用並說明原因（按反向鍵可取消已加的調整）。' +
							'建立時任何屬性不得高於 +2 或低於 -2。' +
							'成長「提升一項屬性」上限 +3、契約傀儡的「黑暗印記」與「非人意識」上限 +4，' +
							'兩者都另計、不受這裡的按鈕限制。昇華是「使用該屬性的動作 +1」的擲骰加值，規則沒有上限，也不改變屬性值本身。')
					);
					root.appendChild(d);
				}

				// 4. 招牌動作
				{
					const sig = pb.signature;
					const d = section('4・' + pb.signatureName, sig.mode === 'options' ? '選擇三個選項' : '');
					if (sig.mode === 'options') {
						const cap = sig.chooseCount + (S.sigExtra || 0);
						if (S.sigExtra) d.appendChild(el('p', 'note ok', '成長已解鎖額外 ' + S.sigExtra + ' 個選項（可選 ' + cap + ' 項）'));
						d.appendChild(
							checkList(
								sig.options,
								(i) => S.sig.includes(i),
								(i, on) => {
									if (on) {
										if (S.sig.length >= cap) {
											toast('最多選擇 ' + cap + ' 項');
											return;
										}
										S.sig.push(i);
									} else S.sig = S.sig.filter((x) => x !== i);
								}
							)
						);
						(sig.granted || []).forEach((m) => {
							const g = el('div', 'granted');
							g.appendChild(el('b', null, '同時獲得：' + m.name));
							g.appendChild(el('p', null, clean(m.text)));
							if (m.table) g.appendChild(tableNode(m.table));
							d.appendChild(g);
						});
					} else {
						(sig.granted || []).forEach((m) => {
							const g = el('div', 'granted');
							g.appendChild(el('b', null, m.name));
							g.appendChild(el('p', null, clean(m.text)));
							if (m.table) g.appendChild(tableNode(m.table));
							d.appendChild(g);
							// 動作內含的選單（聖母「神聖力量」從六項效果選三項）
							if ((m.options || []).length) {
								const cap = (m.chooseCount || 0) + (S.sigExtra || 0);
								d.appendChild(
									el('p', 'note' + (S.sigExtra ? ' ok' : ''),
