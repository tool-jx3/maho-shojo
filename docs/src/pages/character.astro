			.brand .sub { color: var(--ink-dim); font-size: .8rem; }
			.tools { display: flex; flex-wrap: wrap; gap: .4rem; }
			.tools button {
				padding: .35rem .8rem; border-radius: 999px; cursor: pointer;
				border: 1px solid var(--line); background: #1b1638; color: var(--ink);
				transition: background .15s, border-color .15s;
			}
			.tools button:hover { background: #2a2154; border-color: var(--accent); }
