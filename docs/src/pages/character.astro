			}
			button.tiny:hover { border-color: var(--accent); }
			button.small {
				padding: .3rem .7rem; border-radius: 8px; cursor: pointer;
				border: 1px solid var(--line); background: #221b45; color: var(--ink); font-size: .85rem;
			}
			.chips { display: flex; gap: .35rem; flex-wrap: wrap; }
