						go.textContent = '執行「閃耀時刻！」';
						go.disabled = blocked;
						go.title = blocked ? '請先完成上一次成長的處理項目' : '新增一次成長並把盟約閃耀點數歸零';
						go.addEventListener('click', () => {
							ADV_OPEN[S.advances.length] = true;
							S.advances.push({ opt: '', detail: '', done: false });
							S.shine = 0;
							render();
						});
						d.appendChild(go);
						d.appendChild(el('p', 'note dim', '會新增一次成長，並依規則把盟約閃耀點數歸零。'));
					}

					// 成長紀錄
					S.advances.forEach((a, idx) => {
						const isAdvanced = idx >= 5; // 第 6 次起為進階成長
						const pool = advPool(isAdvanced);
						const card = el('details', 'advcard' + (a.done ? ' done' : ''));
						card.open = ADV_OPEN[idx] === undefined ? !a.done : ADV_OPEN[idx];
						card.addEventListener('toggle', () => {
							ADV_OPEN[idx] = card.open;
						});
						const head = el('summary', 'advhead');
						head.appendChild(el('b', null, '第 ' + (idx + 1) + ' 次成長'));
						head.appendChild(el('span', 'tagtype', isAdvanced ? '進階成長' : '基礎成長'));
						if (a.opt) head.appendChild(el('span', 'advsum', a.opt));
						const del = el('button', 'tiny');
						del.type = 'button';
						del.textContent = '✕';
						del.title = '刪除這次成長';
						del.addEventListener('click', (ev) => {
							ev.preventDefault();
							ev.stopPropagation();
							S.advances.splice(idx, 1);
							ADV_OPEN.splice(idx, 1);
							const cleared = revalidateAdvances();
							applyAdvances();
							render();
							if (cleared.length) {
								toast('順序改變後不再合法，已清空請重選：' + cleared.join('、'));
							}
						});
						head.appendChild(del);
						card.appendChild(head);

						// 選擇成長項目
						const sel = el('select');
						const ph = el('option', null, '── 選擇成長項目 ──');
						ph.value = '';
						sel.appendChild(ph);
						pool.forEach((opt) => {
							const used = advBoxUsed(opt.text, isAdvanced, idx);
							const full = used >= opt.boxes;
							const mine = a.opt === opt.text;
							const block = advBlockReason(opt.text, idx);
							const o = el('option', null,
								opt.text + '（欄位 ' + opt.boxes + '・已用 ' + (used + (mine ? 1 : 0)) + '）' +
								(full && !mine ? '　欄位已滿' : block ? '　' + block : ''));
							o.value = opt.text;
							o.disabled = (full || !!block) && !mine;
							if (mine) o.selected = true;
							sel.appendChild(o);
						});
						sel.disabled = !!a.done;
						sel.addEventListener('change', () => {
							a.opt = sel.value;
							a.detail = '';
							render();
						});
						card.appendChild(sel);

						// 依成長項目給出對應的處理控制項
						if (a.opt) {
							const opt = a.opt;
							const meta = pool.find((o) => o.text === opt);
							if (meta && meta.desc) card.appendChild(el('p', 'advdesc', meta.desc));
							const detailWrap = el('div', 'advdetail');
							const setDetail = (v) => {
								a.detail = v;
								render();
							};
							if (opt.indexOf('提升一項屬性') >= 0) {
								const cap = opt.indexOf('3') >= 0 ? 3 : 2;
								const fa = finalAttrs();
								const row = el('div', 'pactrow');
								ATTRS.forEach((k) => {
									const full = fa[k] >= cap && a.detail !== k;
									const b = el('button', 'pactbtn' + (a.detail === k ? ' on' : ''));
									b.type = 'button';
									b.disabled = !!a.done || full;
									b.textContent = k + ' ' + sign(fa[k]) + (full ? '（已達上限）' : '');
									b.addEventListener('click', () => setDetail(k));
									row.appendChild(b);
								});
								detailWrap.appendChild(el('p', 'note dim', '選擇要 +1 的屬性（此項上限 ' + cap + '）'));
								detailWrap.appendChild(row);
							} else if (opt.indexOf('進階動作') >= 0) {
								const row = el('div', 'pactrow wrapy');
								pb.advanceMoves.forEach((m, mi) => {
									const taken = S.advMoves.includes(mi) && a.detail !== String(mi);
									const b = el('button', 'pactbtn' + (a.detail === String(mi) ? ' on' : ''));
									b.type = 'button';
									b.disabled = !!a.done || taken;
									b.textContent = m.name + (taken ? '（已取得）' : '');
									b.addEventListener('click', () => setDetail(String(mi)));
									row.appendChild(b);
								});
								detailWrap.appendChild(el('p', 'note dim', '選擇一個進階動作'));
								detailWrap.appendChild(row);
							} else if (opt.indexOf('友情扮演書動作') >= 0) {
								const fb = frBook();
								if (!fb) {
									detailWrap.appendChild(el('p', 'note warn', '請先在步驟 6 選擇友情扮演書'));
								} else {
									const row = el('div', 'pactrow wrapy');
									fb.moves.forEach((m, mi) => {
										const taken = S.frMoves.includes(mi) && a.detail !== String(mi);
										const b = el('button', 'pactbtn' + (a.detail === String(mi) ? ' on' : ''));
										b.type = 'button';
										b.disabled = !!a.done || taken;
										b.textContent = m.name + (taken ? '（已取得）' : '');
										b.addEventListener('click', () => setDetail(String(mi)));
										row.appendChild(b);
									});
									detailWrap.appendChild(el('p', 'note dim', fb.name + '：選擇一個動作'));
									detailWrap.appendChild(row);
								}
							} else if (opt.indexOf('超級形態') >= 0) {
								const okPrereq = idx >= 2; // 需已有 2 次成長，最早第 3 次
								detailWrap.appendChild(
									el('p', 'note' + (okPrereq ? ' dim' : ' warn'),
										okPrereq ? '完成後解鎖超級形態。' : '需先取得 2 次成長，最早可在第 3 次成長時選擇。')
								);
								if (okPrereq && !a.detail) a.detail = 'super';
								if (!okPrereq) a.detail = '';
							} else if (opt.indexOf('凱旋形態') >= 0) {
								detailWrap.appendChild(el('p', 'note dim', '完成後解鎖凱旋形態。'));
								a.detail = 'triumph';
							} else if (opt.indexOf('額外選項') >= 0) {
								detailWrap.appendChild(el('p', 'note dim', '完成後可在步驟 4 再選 3 個選項。'));
								if (!a.detail) a.detail = 'sig3';
							} else {
								if (!a.detail) a.detail = 'ok';
							}
							card.appendChild(detailWrap);
						}

						// 完成勾選：未填妥處理項目不能完成
						const doneRow = el('label', 'check inline');
						const cb = el('input');
						cb.type = 'checkbox';
						cb.checked = !!a.done;
						cb.disabled = !a.opt || !a.detail;
						cb.addEventListener('change', () => {
							a.done = cb.checked;
							applyAdvances();
							render();
						});
						doneRow.appendChild(cb);
						doneRow.appendChild(
							el('span', null, a.done ? '已完成處理' : !a.opt ? '請先選擇成長項目' : !a.detail ? '請完成上方處理項目' : '標記為已完成')
						);
						card.appendChild(doneRow);
						d.appendChild(card);
					});

					const pending = S.advances.some((a) => !a.done);
					const nextAdvanced = S.advances.length >= 5;
					const nextPool = advPool(nextAdvanced);
					const poolFull = nextPool.every(
						(o) => advBoxUsed(o.text, nextAdvanced, -1) >= o.boxes
					);
					const add = el('button', 'small');
					add.type = 'button';
					add.textContent = '＋ 新增一次成長';
					add.disabled = pending || poolFull;
					add.title = pending ? '請先完成上一次成長的處理項目' : poolFull ? '此類成長的欄位已全部勾選' : '';
					add.addEventListener('click', () => {
						ADV_OPEN[S.advances.length] = true;
						S.advances.push({ opt: '', detail: '', done: false });
						render();
					});
					d.appendChild(add);
					if (pending) d.appendChild(el('p', 'note warn', '上一次成長尚未處理完成，無法再升下一級。'));
					else if (poolFull)
						d.appendChild(
							el('p', 'note warn', (nextAdvanced ? '進階成長' : '基礎成長') + '的欄位已全部勾選，無法再選擇。')
						);

					// 成長欄位總覽（對應官方扮演書上的 ○ 欄位）
					d.appendChild(el('p', 'note', '成長欄位（填滿＝已勾選）'));
					d.appendChild(advBoxTable());

					// 目前已取得的進階動作一覽（唯讀，由成長流程產生）
					if (S.advMoves.length) {
						d.appendChild(el('p', 'note', '已取得的' + pb.name + '進階動作'));
						const ul3 = el('ul', 'rules');
						S.advMoves.forEach((i) => pb.advanceMoves[i] && ul3.appendChild(el('li', null, pb.advanceMoves[i].name)));
						d.appendChild(ul3);
					}
					root.appendChild(d);
				}

				// 9. 狀態
				{
					const d = section('9・狀態與後果');
					const g = el('div', 'fgrid');
					g.appendChild(field('光點', numInput('light', 0, 20)));
					g.appendChild(field('暗點', numInput('tenebrae', 0, 5)));
					g.appendChild(field('友情點數', numInput('amity', 0, 10)));
					g.appendChild(field('黑暗點數', numInput('dark', 0, 20)));
					g.appendChild(field('黑暗等級', numInput('darkLv', 0, 5)));
					if (romBook()) g.appendChild(field('戀愛等級', numInput('romLv', 0, 5)));
					if (S.pb === '鬥士') g.appendChild(field('活力', numInput('impetus', 0, 20)));
					if (S.pb === '偶像') g.appendChild(field('人氣值', numInput('popularity', 0, popularityMax())));
					d.appendChild(g);
					d.appendChild(
						el('p', 'note dim',
							'暗點與光點互相抵銷，上限 5；場景結束或脫下光之裝束時減少 1 點。友情點數上限 10，歸零會觸發阿特洛波斯之禍。')
					);
					if (S.light > 0 && S.tenebrae > 0) {
						d.appendChild(el('p', 'note warn', '光點與暗點不會同時存在，請依規則互相抵銷。'));
					}
					d.appendChild(el('p', 'note', '後果'));
					d.appendChild(
						el('p', 'note dim',
							'標記一項後果可抵消最多 4 點傷痛（堅韌會再增加），並使對應屬性 -2，直到後果被消除為止。')
					);
					const box = el('div', 'checklist');
					pb.consequences.concat(['落敗']).forEach((c, i) => {
						const info = (RULES.consequenceInfo || {})[c] || {};
						const row = el('label', 'check');
						const cb = el('input');
						cb.type = 'checkbox';
						cb.checked = (S.cons || []).includes(i);
						cb.addEventListener('change', () => {
							S.cons = S.cons || [];
							if (cb.checked) S.cons.push(i);
							else S.cons = S.cons.filter((x) => x !== i);
							render();
						});
						row.appendChild(cb);
						const body = el('span', 'ctext');
						body.appendChild(el('b', null, c + (info.attribute ? '（' + info.attribute + ' -2）' : '')));
						if (info.text) body.appendChild(el('span', 'cdesc', clean(info.text)));
						row.appendChild(body);
						box.appendChild(row);
					});
					d.appendChild(box);
					const marked = (S.cons || [])
						.map((i) => pb.consequences.concat(['落敗'])[i])
						.filter(Boolean);
					if (marked.length) {
						const penal = marked
							.map((c) => ((RULES.consequenceInfo || {})[c] || {}).attribute)
							.filter(Boolean);
						d.appendChild(
							el('p', 'note warn',
								'目前受影響的屬性：' + (penal.length ? penal.map((k) => k + ' -2').join('、') : '無') +
								(marked.includes('落敗') ? '；落敗：無法繼續行動，場景結束後自動取消並執行「失去光明」。' : ''))
						);
					}
					const ta = el('textarea');
					ta.rows = 3;
					ta.placeholder = '羈絆與角色介紹……';
					ta.value = S.bonds || '';
					ta.addEventListener('input', () => {
						S.bonds = ta.value;
						renderSheet();
						syncURL();
					});
					d.appendChild(field('羈絆／備註', ta));
					root.appendChild(d);
				}
			}

			// ========== 角色卡預覽（A4） ==========
			function sheetBlock(title, nodes) {
				const b = el('div', 'blk');
				b.appendChild(el('h3', null, title));
				nodes.forEach((n) => b.appendChild(n));
				return b;
			}
			function kv(k, v) {
				const r = el('div', 'kv');
				r.appendChild(el('span', 'k', k));
				r.appendChild(el('span', 'v', v || '—'));
				return r;
			}
			// checks 為布林陣列時，每一項前方加上方框（勾選者填滿），方便實體桌面對照
			function moveList(items, checks) {
				const ul = el('ul', 'mlist');
				items.forEach((m, i) => {
					const li = el('li');
					const b = el('b');
					if (checks) b.appendChild(boxRow(1, checks[i] ? 1 : 0));
					b.appendChild(el('span', 'mname', m.name));
					li.appendChild(b);
					if (m.text) li.appendChild(el('span', null, clean(m.text)));
					if (m.table) li.appendChild(tableNode(m.table, 'minitable sheet'));
					ul.appendChild(li);
				});
				return ul;
			}

			function renderSheet() {
				const root = $('#sheet');
				root.textContent = '';
				const pb = playbook();
				if (!pb) {
					const empty = el('div', 'page empty');
					empty.appendChild(el('p', null, '選擇一本原型扮演書後，這裡會即時顯示角色卡。'));
					root.appendChild(empty);
					return;
				}
				const fa = finalAttrs();

				// ---- 第 1 頁 ----
				const p1 = el('div', 'page');
				const head = el('header', 'shead');
				const hl = el('div');
				hl.appendChild(el('h2', null, S.name || '未命名魔法少女'));
				hl.appendChild(el('p', 'stitle2', S.title || '（尚未取稱號）'));
				head.appendChild(hl);
				const hr = el('div', 'pbtag');
				hr.appendChild(el('b', null, pb.name));
				hr.appendChild(el('span', null, S.pact || '未定盟約'));
				head.appendChild(hr);
				p1.appendChild(head);

				const pen = consPenalty();
				const ascMap = S.ascension || {};
				const sParts = attrParts();
				const attrRow = el('div', 'sattrs');
				ATTRS.forEach((k) => {
					const c = el('div', 'sattr' + (pen[k] ? ' penal' : ''));
					c.appendChild(el('span', null, k));
					c.appendChild(el('b', null, sign(fa[k])));
					const from = [];
					if (sParts[k].adv) from.push('成長 ' + sign(sParts[k].adv));
					if (sParts[k].dark) from.push(sParts[k].darkFrom.join('、') + ' ' + sign(sParts[k].dark));
					if (from.length) c.appendChild(el('span', 'srcnote', from.join('／')));
					if (ascMap[k]) c.appendChild(el('span', 'bonus', '昇華 +' + ascMap[k] + '（擲骰）'));
					if (pen[k]) c.appendChild(el('span', 'penalty', '後果 -2 → ' + sign(fa[k] + pen[k])));
					attrRow.appendChild(c);
				});
				p1.appendChild(attrRow);

				const info = el('div', 'cols2');
				const c1 = el('div');
				c1.appendChild(kv('生活型態', S.life));
				c1.appendChild(kv('年齡', S.age));
				c1.appendChild(kv('星座', S.zodiac));
				c1.appendChild(kv('血型', S.blood));
				const c2 = el('div');
				c2.appendChild(kv('主題', S.theme));
				c2.appendChild(kv('色彩', S.color));
				c2.appendChild(kv('護符', S.talisman));
				c2.appendChild(kv('最珍貴的寶物', S.treasure));
				info.appendChild(c1);
				info.appendChild(c2);
				p1.appendChild(sheetBlock('個人資料與變身', [info]));

				// 盟約與扮演書（即使沒有勾選動作也一定出現在列印內容中）
				const books = el('div', 'cols2');
				const bl = el('div');
				bl.appendChild(kv('盟約', S.pact));
				const fbSheet = frBook();
				bl.appendChild(kv('友情扮演書', fbSheet ? fbSheet.name : ''));
				const br = el('div');
				const rbSheet = romBook();
				br.appendChild(kv('戀愛扮演書', rbSheet ? rbSheet.name : ''));
				br.appendChild(kv('成長次數', String(S.advances.filter((a) => a.done).length)));
				books.appendChild(bl);
				books.appendChild(br);
				const bookExtras = [books];
				if (fbSheet && fbSheet.tags) bookExtras.push(el('p', 'tiny-note', '友情標籤：' + fbSheet.tags));
				p1.appendChild(sheetBlock('盟約與扮演書', bookExtras));

				// 能力量表：可能被取代（如偶像黑暗動作「黑暗女神」）或多一個額外形態（如「契約形態」）
				const lv = luxView();
				const tbl = el('table', 'lux');
				const thead = el('thead');
				const htr = el('tr');
				const tb = el('tbody');
				const extraByLevel = {};
				if (lv.extra) (lv.extra.formTable || []).forEach((r) => (extraByLevel[r.level] = r.effect));

				if (lv.replace) {
					// 整張量表被取代：直接照原表輸出
					lv.replace.table.headers.forEach((h) => htr.appendChild(el('th', null, h)));
					if (lv.extra) htr.appendChild(el('th', null, lv.extra.name));
					lv.replace.table.rows.forEach((r) => {
						const lvNum = parseInt(r[0], 10);
						const tr = el('tr', S.power >= lvNum ? 'on' : '');
						r.forEach((c, ci) => {
							const lock = (ci === 2 && !S.superForm) || (ci === 3 && !S.triumphForm);
							tr.appendChild(el('td', lock ? 'lock' : '', c || '—'));
						});
						if (lv.extra) tr.appendChild(el('td', null, extraByLevel[lvNum] || '—'));
						tb.appendChild(tr);
					});
				} else {
					const heads = ['等級', '基礎形態', '超級形態', '凱旋形態'];
					if (lv.extra) heads.push(lv.extra.name);
					heads.forEach((h) => htr.appendChild(el('th', null, h)));
					lv.rows.forEach((r) => {
						const tr = el('tr', S.power >= r.level ? 'on' : '');
						tr.appendChild(el('td', null, String(r.level)));
						tr.appendChild(el('td', null, r.basic));
						tr.appendChild(el('td', S.superForm ? '' : 'lock', r.super || '—'));
						tr.appendChild(el('td', S.triumphForm ? '' : 'lock', r.triumph || '—'));
						if (lv.extra) tr.appendChild(el('td', null, extraByLevel[r.level] || '—'));
						tb.appendChild(tr);
					});
				}
				thead.appendChild(htr);
				tbl.appendChild(thead);
				tbl.appendChild(tb);
				const luxNote = el('p', 'tiny-note',
					'能力等級 ' + S.power +
					'　超級形態：' + (S.superForm ? '已解鎖' : '未解鎖') +
					'　凱旋形態：' + (S.triumphForm ? '已解鎖' : '未解鎖') +
					(lv.extra ? '　' + lv.extra.name + '：已取得' : '') +
					(lv.replace ? '　※ 量表已由「' + lv.replace.name + '」取代，使用暗點計算等級' : ''));
				p1.appendChild(
					sheetBlock('光之裝束・能力量表', [tbl, luxNote, powerSummary(true), el('p', 'tiny-note', '目前解鎖的力量（變身後基礎為懲罰 1、摧毀 0，各形態與各等級累加）')])
				);

				const hearts = (S.hearts || []).filter((h) => h.name || h.effect || h.rule);
				if (hearts.length) {
					p1.appendChild(
						sheetBlock('心之力', [
							moveList(
								hearts.map((h) => ({
									name: '（' + h.cat + '）' + (h.name || '未命名'),
									text: [h.rule, h.effect].filter(Boolean).join('\n'),
								}))
							),
						])
					);
				}

				// 狀態
				const st = el('div', 'status');
				st.appendChild(kv('光點', String(S.light)));
				st.appendChild(kv('暗點', S.tenebrae + ' / 5'));
				st.appendChild(kv('友情點數', S.amity + ' / 10'));
				st.appendChild(kv('黑暗點數', String(S.dark)));
				st.appendChild(kv('黑暗等級', String(S.darkLv)));
				st.appendChild(kv('閃耀點數', S.shine + ' / ' + ((S.players || 4) + doneAdvCount())));
				if (romBook()) st.appendChild(kv('戀愛等級', S.romLv + ' / 5'));
				if (S.pb === '鬥士') st.appendChild(kv('活力', String(S.impetus)));
				if (S.pb === '偶像') st.appendChild(kv('人氣值', S.popularity + ' / ' + popularityMax()));
				const consAll = pb.consequences.concat(['落敗']);
				const cbox = el('div', 'cons');
				consAll.forEach((c, i) => {
					const on = (S.cons || []).includes(i);
					const info = (RULES.consequenceInfo || {})[c] || {};
					const t = el('span', 'consitem' + (on ? ' on' : ''));
					t.appendChild(boxRow(1, on ? 1 : 0));
					t.appendChild(el('span', null, c + (info.attribute ? '（' + info.attribute + ' -2）' : '')));
					cbox.appendChild(t);
				});
				p1.appendChild(
					sheetBlock('狀態', [
						st,
						cbox,
						el('p', 'tiny-note', '標記一項後果可抵消最多 4 點傷痛（堅韌再增加），並使對應屬性 -2，直到後果被消除為止。'),
					])
				);

				if (S.bonds) p1.appendChild(sheetBlock('羈絆與備註', [el('p', 'freetext', S.bonds)]));
				root.appendChild(p1);

				// ---- 第 2 頁：動作 ----
				const p2 = el('div', 'page');
				p2.appendChild(el('h2', 'pagetitle', (S.name || '角色') + '・動作一覽'));

				// 所有可勾選的選項都完整列出，前方方框標示是否已選，方便實體桌面對照
				const picked = (list) => (items) => items.map((_, i) => list.includes(i));

				const sig = pb.signature;
				const sigNodes = [];
				if ((sig.granted || []).length) {
					sigNodes.push(el('p', 'tiny-note', '自動獲得'));
					sigNodes.push(moveList(sig.granted, sig.granted.map(() => true)));
				}
				const embedded = (sig.granted || []).find((m) => (m.options || []).length);
				const sigPool =
					sig.mode === 'options' ? sig.options : (sig.chooseFrom || []).length ? sig.chooseFrom : embedded ? embedded.options : [];
				if ((sigPool || []).length) {
					const total = (embedded ? embedded.chooseCount || 0 : sig.chooseCount || 0) + (S.sigExtra || 0);
					sigNodes.push(
						el('p', 'tiny-note', '可選 ' + total + ' 項　已選 ' + S.sig.length + ' 項')
					);
					sigNodes.push(moveList(sigPool, picked(S.sig)(sigPool)));
				}
				if (sigNodes.length) p2.appendChild(sheetBlock(pb.signatureName, sigNodes));

				p2.appendChild(
					sheetBlock(pb.name + '進階動作', [
						moveList(pb.advanceMoves, picked(S.advMoves)(pb.advanceMoves)),
					])
				);

				const pc = pact();
				if (pc) {
					if ((pc.advantages || []).length) {
						p2.appendChild(
							sheetBlock(pc.name + '・盟約優勢', [
								moveList(
									pc.advantages.map((a) => ({ name: a.name, text: a.text, table: a.table })),
									picked(S.pactAdv || [])(pc.advantages)
								),
							])
						);
					}
					if ((pc.moves || []).length) {
						p2.appendChild(
							sheetBlock(pc.name + '・盟約動作', [moveList(pc.moves, picked(S.pactMoves)(pc.moves))])
						);
					}
					if ((pc.coopMoves || []).length) {
						p2.appendChild(
							sheetBlock(pc.name + '・合作動作', [
								el('p', 'tiny-note', '勾選者為因黑暗等級而無法再觸發的動作'),
								moveList(pc.coopMoves, picked(S.lostCoop || [])(pc.coopMoves)),
							])
						);
					}
					const dmList = (pc.darkMoves || {})[S.pb] || [];
					if (dmList.length) {
						p2.appendChild(
							sheetBlock(S.pb + '黑暗動作', [moveList(dmList, picked(S.darkMoves || [])(dmList))])
						);
					}
				}
				const fb = frBook();
				const frAll = effFrMoves();
				if (fb) {
					p2.appendChild(
						sheetBlock('友情・' + fb.name, [moveList(fb.moves, picked(frAll)(fb.moves))])
					);
				}
				const rb = romBook();
				if (rb) {
					p2.appendChild(
						sheetBlock('戀愛・' + rb.name, [
							el('p', 'tiny-note', '戀愛扮演書的動作全部自動獲得'),
							moveList(rb.moves, rb.moves.map(() => true)),
						])
					);
				}

				const doneAdv = S.advances.filter((a) => a.done);
				if (doneAdv.length) {
					const ul = el('ul', 'mlist compact');
					doneAdv.forEach((a, i) => {
						const li = el('li');
						let detail = '';
						if (a.opt.indexOf('提升一項屬性') >= 0) detail = a.detail + ' +1';
						else if (a.opt.indexOf('進階動作') >= 0) detail = (pb.advanceMoves[a.detail] || {}).name || '';
						else if (a.opt.indexOf('友情扮演書動作') >= 0) {
							const fbx = frBook();
							detail = fbx ? (fbx.moves[a.detail] || {}).name || '' : '';
						} else if (a.detail === 'super') detail = '超級形態';
						else if (a.detail === 'triumph') detail = '凱旋形態';
						else if (a.detail === 'sig3') detail = '額外三個選項';
						li.appendChild(el('b', null, '第 ' + (i + 1) + ' 次：' + a.opt));
						if (detail) li.appendChild(el('span', null, detail));
						ul.appendChild(li);
					});
					p2.appendChild(sheetBlock('成長紀錄', [ul]));
				}
				p2.appendChild(sheetBlock('成長欄位', [advBoxTable('advboxes sheet')]));

				const consInfo = pb.consequences.concat(['落敗']).map((c) => {
					const info = (RULES.consequenceInfo || {})[c] || {};
					return { name: c + (info.attribute ? '（' + info.attribute + ' -2）' : ''), text: info.text || '' };
				});
				p2.appendChild(
					sheetBlock('後果', [
						moveList(consInfo, pb.consequences.concat(['落敗']).map((_, i) => (S.cons || []).includes(i))),
					])
				);

				const basics = el('ul', 'mlist compact');
				const attrLabel = (a) => (a === '屬性' ? '視情況決定的屬性' : a);
				RULES.basicMoves.forEach((m) => {
					const li = el('li');
					li.appendChild(el('b', null, m.name + (m.attribute ? '（+' + attrLabel(m.attribute) + '）' : '')));
					if (m.trigger) li.appendChild(el('span', null, m.trigger));
					basics.appendChild(li);
				});
				p2.appendChild(sheetBlock('基礎動作（全角色共通）', [basics]));
				root.appendChild(p2);
			}

			function render() {
				syncPowerLevel();
				applyAdvances();
				renderBuilder();
				renderSheet();
				syncURL();
			}

			// ========== 匯出／匯入／分享／列印 ==========
			$('#btn-export').addEventListener('click', () => {
				const blob = new Blob([JSON.stringify(S, null, 2)], { type: 'application/json' });
				const a = el('a');
				a.href = URL.createObjectURL(blob);
				a.download = (S.name || 'maho-shojo') + '.json';
				a.click();
				setTimeout(() => URL.revokeObjectURL(a.href), 1000);
				toast('已匯出 JSON');
			});
			$('#btn-import').addEventListener('click', () => $('#file-input').click());
			$('#file-input').addEventListener('change', async (e) => {
				const f = e.target.files && e.target.files[0];
				if (!f) return;
				try {
					const obj = JSON.parse(await f.text());
					S = Object.assign(structuredClone(BLANK), obj);
					ADV_OPEN = [];
					render();
					toast('已匯入 ' + f.name);
				} catch (err) {
					toast('匯入失敗：不是有效的角色 JSON');
				}
				e.target.value = '';
			});
			$('#btn-share').addEventListener('click', async () => {
				try {
					const code = await encodeState();
					const url = location.origin + location.pathname + '#c=' + code;
					history.replaceState(null, '', '#c=' + code);
					await navigator.clipboard.writeText(url);
					toast('已複製分享網址（' + url.length + ' 字元）');
				} catch (err) {
					toast('複製失敗，請手動複製網址列');
				}
			});
			// window.print() 會同步阻塞，直接寫在事件處理內會被計入 INP；改為讓瀏覽器先完成這一幀
			$('#btn-print').addEventListener('click', () => {
				requestAnimationFrame(() => setTimeout(() => window.print(), 0));
			});
			$('#btn-reset').addEventListener('click', () => {
				if (!confirm('確定要清空目前的角色卡？')) return;
				S = structuredClone(BLANK);
				ADV_OPEN = [];
				history.replaceState(null, '', location.pathname);
				render();
			});

			// ========== 初始化：讀取網址中的角色 ==========
			(async () => {
				const m = location.hash.match(/[#&]c=([^&]+)/);
				if (m) {
					try {
						S = Object.assign(structuredClone(BLANK), await decodeState(m[1]));
						ADV_OPEN = [];
					} catch (e) {
						toast('網址中的角色資料無法解讀，已開新卡');
					}
				}
				render();
			})();
		</script>

