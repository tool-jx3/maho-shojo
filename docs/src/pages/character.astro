				padding: .4rem .2rem; border: 1px solid var(--line); border-radius: 10px; background: #171233;
			}
			.akey { font-size: .78rem; color: var(--ink-dim); }
			.aval { font-size: 1.35rem; color: var(--star); }
			.actrl { display: flex; gap: .2rem; }
			button.tiny {
				width: 1.5rem; height: 1.5rem; line-height: 1; cursor: pointer;
