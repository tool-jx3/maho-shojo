				// 8. 成長（閃耀時刻！）
				{
					const done = S.advances.filter((a) => a.done).length;
					const d = section('8・成長（閃耀時刻！）', '已完成 ' + done + ' 次');

					// 閃耀點數門檻
					const g = el('div', 'fgrid');
					g.appendChild(field('盟約閃耀點數', numInput('shine', 0, 40)));
					g.appendChild(field('玩家角色人數', numInput('players', 1, 8)));
					d.appendChild(g);
					const need = (S.players || 4) + S.advances.length;
					const gate = el('p', 'note' + (S.shine >= need ? ' ok' : ''));
					gate.textContent =
						'觸發門檻：玩家角色人數 + 已獲得成長次數 = ' + need +
						'　目前 ' + S.shine + (S.shine >= need ? '　✓ 可執行「閃耀時刻！」' : '　尚未達成');
					d.appendChild(gate);

					// 成長紀錄
					S.advances.forEach((a, idx) => {
						const isAdvanced = idx >= 5; // 第 6 次起為進階成長
						const pool = isAdvanced ? pb.advancedAdvances : pb.basicAdvances;
						const card = el('div', 'advcard' + (a.done ? ' done' : ''));
						const head = el('div', 'advhead');
						head.appendChild(el('b', null, '第 ' + (idx + 1) + ' 次成長'));
						head.appendChild(el('span', 'tagtype', isAdvanced ? '進階成長' : '基礎成長'));
						const del = el('button', 'tiny');
						del.type = 'button';
						del.textContent = '✕';
						del.title = '刪除這次成長';
						del.addEventListener('click', () => {
							S.advances.splice(idx, 1);
							applyAdvances();
							render();
						});
						head.appendChild(del);
						card.appendChild(head);

						// 選擇成長項目
						const sel = el('select');
						const ph = el('option', null, '── 選擇成長項目 ──');
						ph.value = '';
						sel.appendChild(ph);
						pool.forEach((opt) => {
							const used = advBoxUsed(opt.text, isAdvanced, idx);
							const full = used >= opt.boxes;
							const mine = a.opt === opt.text;
							const block = advBlockReason(opt.text, idx);
							const o = el('option', null,
								opt.text + '（欄位 ' + opt.boxes + '・已用 ' + (used + (mine ? 1 : 0)) + '）' +
								(full && !mine ? '　欄位已滿' : block ? '　' + block : ''));
							o.value = opt.text;
							o.disabled = (full || !!block) && !mine;
							if (mine) o.selected = true;
							sel.appendChild(o);
						});
						sel.disabled = !!a.done;
						sel.addEventListener('change', () => {
							a.opt = sel.value;
							a.detail = '';
							render();
						});
						card.appendChild(sel);

						// 依成長項目給出對應的處理控制項
						if (a.opt) {
							const opt = a.opt;
							const meta = pool.find((o) => o.text === opt);
							if (meta && meta.desc) card.appendChild(el('p', 'advdesc', meta.desc));
							const detailWrap = el('div', 'advdetail');
							const setDetail = (v) => {
								a.detail = v;
								render();
							};
							if (opt.indexOf('提升一項屬性') >= 0) {
								const cap = opt.indexOf('3') >= 0 ? 3 : 2;
								const fa = finalAttrs();
								const row = el('div', 'pactrow');
								ATTRS.forEach((k) => {
									const full = fa[k] >= cap && a.detail !== k;
									const b = el('button', 'pactbtn' + (a.detail === k ? ' on' : ''));
									b.type = 'button';
									b.disabled = !!a.done || full;
									b.textContent = k + ' ' + sign(fa[k]) + (full ? '（已達上限）' : '');
									b.addEventListener('click', () => setDetail(k));
									row.appendChild(b);
								});
								detailWrap.appendChild(el('p', 'note dim', '選擇要 +1 的屬性（此項上限 ' + cap + '）'));
								detailWrap.appendChild(row);
							} else if (opt.indexOf('進階動作') >= 0) {
								const row = el('div', 'pactrow wrapy');
								pb.advanceMoves.forEach((m, mi) => {
									const taken = S.advMoves.includes(mi) && a.detail !== String(mi);
									const b = el('button', 'pactbtn' + (a.detail === String(mi) ? ' on' : ''));
									b.type = 'button';
									b.disabled = !!a.done || taken;
									b.textContent = m.name + (taken ? '（已取得）' : '');
									b.addEventListener('click', () => setDetail(String(mi)));
									row.appendChild(b);
								});
								detailWrap.appendChild(el('p', 'note dim', '選擇一個進階動作'));
								detailWrap.appendChild(row);
							} else if (opt.indexOf('友情扮演書動作') >= 0) {
								const fb = frBook();
								if (!fb) {
									detailWrap.appendChild(el('p', 'note warn', '請先在步驟 6 選擇友情扮演書'));
								} else {
									const row = el('div', 'pactrow wrapy');
									fb.moves.forEach((m, mi) => {
										const taken = S.frMoves.includes(mi) && a.detail !== String(mi);
										const b = el('button', 'pactbtn' + (a.detail === String(mi) ? ' on' : ''));
										b.type = 'button';
										b.disabled = !!a.done || taken;
										b.textContent = m.name + (taken ? '（已取得）' : '');
										b.addEventListener('click', () => setDetail(String(mi)));
										row.appendChild(b);
									});
									detailWrap.appendChild(el('p', 'note dim', fb.name + '：選擇一個動作'));
									detailWrap.appendChild(row);
								}
							} else if (opt.indexOf('超級形態') >= 0) {
								const okPrereq = idx >= 2; // 需已有 2 次成長，最早第 3 次
								detailWrap.appendChild(
									el('p', 'note' + (okPrereq ? ' dim' : ' warn'),
										okPrereq ? '完成後解鎖超級形態。' : '需先取得 2 次成長，最早可在第 3 次成長時選擇。')
								);
								if (okPrereq && !a.detail) a.detail = 'super';
								if (!okPrereq) a.detail = '';
							} else if (opt.indexOf('凱旋形態') >= 0) {
								const hasSuper = S.superForm || S.advances.some((x, i) => i !== idx && x.done && x.detail === 'super');
								detailWrap.appendChild(
									el('p', 'note dim',
										hasSuper ? '完成後解鎖凱旋形態。' : '尚未擁有超級形態，依規則本次改為取得超級形態。')
								);
								a.detail = hasSuper ? 'triumph' : 'super';
							} else if (opt.indexOf('額外選項') >= 0) {
								detailWrap.appendChild(el('p', 'note dim', '完成後可在步驟 4 再選 3 個選項。'));
								if (!a.detail) a.detail = 'sig3';
							} else {
								if (!a.detail) a.detail = 'ok';
							}
							card.appendChild(detailWrap);
						}

						// 完成勾選：未填妥處理項目不能完成
						const doneRow = el('label', 'check inline');
						const cb = el('input');
						cb.type = 'checkbox';
						cb.checked = !!a.done;
						cb.disabled = !a.opt || !a.detail;
						cb.addEventListener('change', () => {
							a.done = cb.checked;
							applyAdvances();
							render();
						});
						doneRow.appendChild(cb);
						doneRow.appendChild(
							el('span', null, a.done ? '已完成處理' : !a.opt ? '請先選擇成長項目' : !a.detail ? '請完成上方處理項目' : '標記為已完成')
						);
						card.appendChild(doneRow);
						d.appendChild(card);
					});

					const pending = S.advances.some((a) => !a.done);
					const nextAdvanced = S.advances.length >= 5;
					const nextPool = nextAdvanced ? pb.advancedAdvances : pb.basicAdvances;
					const poolFull = nextPool.every(
						(o) => advBoxUsed(o.text, nextAdvanced, -1) >= o.boxes
					);
					const add = el('button', 'small');
					add.type = 'button';
					add.textContent = '＋ 新增一次成長';
					add.disabled = pending || poolFull;
					add.title = pending ? '請先完成上一次成長的處理項目' : poolFull ? '此類成長的欄位已全部勾選' : '';
					add.addEventListener('click', () => {
						S.advances.push({ opt: '', detail: '', done: false });
						render();
					});
					d.appendChild(add);
					if (pending) d.appendChild(el('p', 'note warn', '上一次成長尚未處理完成，無法再升下一級。'));
					else if (poolFull)
						d.appendChild(
							el('p', 'note warn', (nextAdvanced ? '進階成長' : '基礎成長') + '的欄位已全部勾選，無法再選擇。')
						);

					// 成長欄位總覽（對應官方扮演書上的 ○ 欄位）
					d.appendChild(el('p', 'note', '成長欄位（填滿＝已勾選）'));
					d.appendChild(advBoxTable());

					// 目前已取得的進階動作一覽（唯讀，由成長流程產生）
					if (S.advMoves.length) {
						d.appendChild(el('p', 'note', '已取得的' + pb.name + '進階動作'));
						const ul3 = el('ul', 'rules');
						S.advMoves.forEach((i) => pb.advanceMoves[i] && ul3.appendChild(el('li', null, pb.advanceMoves[i].name)));
						d.appendChild(ul3);
					}
					root.appendChild(d);
				}

				// 9. 狀態
				{
					const d = section('9・狀態與後果');
					const g = el('div', 'fgrid');
					g.appendChild(field('光點', numInput('light', 0, 20)));
					g.appendChild(field('黑暗點數', numInput('dark', 0, 20)));
					g.appendChild(field('黑暗等級', numInput('darkLv', 0, 5)));
					d.appendChild(g);
					d.appendChild(el('p', 'note', '後果'));
					const box = el('div', 'checklist compact');
					pb.consequences.concat(['落敗']).forEach((c, i) => {
						const row = el('label', 'check');
						const cb = el('input');
						cb.type = 'checkbox';
						cb.checked = (S.cons || []).includes(i);
						cb.addEventListener('change', () => {
							S.cons = S.cons || [];
							if (cb.checked) S.cons.push(i);
							else S.cons = S.cons.filter((x) => x !== i);
							render();
						});
						row.appendChild(cb);
						row.appendChild(el('span', 'ctext', c));
						box.appendChild(row);
					});
					d.appendChild(box);
					const ta = el('textarea');
					ta.rows = 3;
					ta.placeholder = '羈絆與角色介紹……';
					ta.value = S.bonds || '';
					ta.addEventListener('input', () => {
						S.bonds = ta.value;
						renderSheet();
						syncURL();
					});
					d.appendChild(field('羈絆／備註', ta));
					root.appendChild(d);
				}
			}

			// ========== 角色卡預覽（A4） ==========
			function sheetBlock(title, nodes) {
				const b = el('div', 'blk');
				b.appendChild(el('h3', null, title));
				nodes.forEach((n) => b.appendChild(n));
				return b;
			}
			function kv(k, v) {
				const r = el('div', 'kv');
				r.appendChild(el('span', 'k', k));
				r.appendChild(el('span', 'v', v || '—'));
				return r;
			}
			// checks 為布林陣列時，每一項前方加上方框（勾選者填滿），方便實體桌面對照
			function moveList(items, checks) {
				const ul = el('ul', 'mlist');
				items.forEach((m, i) => {
					const li = el('li');
					const b = el('b');
					if (checks) b.appendChild(boxRow(1, checks[i] ? 1 : 0));
					b.appendChild(el('span', 'mname', m.name));
					li.appendChild(b);
					if (m.text) li.appendChild(el('span', null, m.text.replace(/\*\*/g, '').replace(/\[(.+?)\]\(.+?\)/g, '$1')));
					if (m.table) li.appendChild(tableNode(m.table, 'minitable sheet'));
					ul.appendChild(li);
				});
				return ul;
			}

			function renderSheet() {
				const root = $('#sheet');
				root.textContent = '';
				const pb = playbook();
				if (!pb) {
					const empty = el('div', 'page empty');
					empty.appendChild(el('p', null, '選擇一本原型扮演書後，這裡會即時顯示角色卡。'));
					root.appendChild(empty);
					return;
				}
				const fa = finalAttrs();

				// ---- 第 1 頁 ----
				const p1 = el('div', 'page');
				const head = el('header', 'shead');
				const hl = el('div');
				hl.appendChild(el('h2', null, S.name || '未命名魔法少女'));
				hl.appendChild(el('p', 'stitle2', S.title || '（尚未取稱號）'));
				head.appendChild(hl);
				const hr = el('div', 'pbtag');
				hr.appendChild(el('b', null, pb.name));
				hr.appendChild(el('span', null, S.pact || '未定盟約'));
				head.appendChild(hr);
				p1.appendChild(head);

				const attrRow = el('div', 'sattrs');
				ATTRS.forEach((k) => {
					const c = el('div', 'sattr');
					c.appendChild(el('span', null, k));
					c.appendChild(el('b', null, sign(fa[k])));
					attrRow.appendChild(c);
				});
				p1.appendChild(attrRow);

				const info = el('div', 'cols2');
				const c1 = el('div');
				c1.appendChild(kv('生活型態', S.life));
				c1.appendChild(kv('年齡', S.age));
				c1.appendChild(kv('星座', S.zodiac));
				c1.appendChild(kv('血型', S.blood));
				const c2 = el('div');
				c2.appendChild(kv('主題', S.theme));
				c2.appendChild(kv('色彩', S.color));
				c2.appendChild(kv('護符', S.talisman));
				c2.appendChild(kv('最珍貴的寶物', S.treasure));
				info.appendChild(c1);
				info.appendChild(c2);
				p1.appendChild(sheetBlock('個人資料與變身', [info]));

				// 盟約與扮演書（即使沒有勾選動作也一定出現在列印內容中）
				const books = el('div', 'cols2');
				const bl = el('div');
				bl.appendChild(kv('盟約', S.pact));
				const fbSheet = frBook();
				bl.appendChild(kv('友情扮演書', fbSheet ? fbSheet.name : ''));
				const br = el('div');
				const rbSheet = romBook();
				br.appendChild(kv('戀愛扮演書', rbSheet ? rbSheet.name : ''));
				br.appendChild(kv('成長次數', String(S.advances.filter((a) => a.done).length)));
				books.appendChild(bl);
				books.appendChild(br);
				const bookExtras = [books];
				if (fbSheet && fbSheet.tags) bookExtras.push(el('p', 'tiny-note', '友情標籤：' + fbSheet.tags));
				p1.appendChild(sheetBlock('盟約與扮演書', bookExtras));

				// 能力量表：可能被取代（如偶像黑暗動作「黑暗女神」）或多一個額外形態（如「契約形態」）
				const lv = luxView();
				const tbl = el('table', 'lux');
				const thead = el('thead');
				const htr = el('tr');
				const tb = el('tbody');
				const extraByLevel = {};
				if (lv.extra) (lv.extra.formTable || []).forEach((r) => (extraByLevel[r.level] = r.effect));

				if (lv.replace) {
					// 整張量表被取代：直接照原表輸出
					lv.replace.table.headers.forEach((h) => htr.appendChild(el('th', null, h)));
					if (lv.extra) htr.appendChild(el('th', null, lv.extra.name));
					lv.replace.table.rows.forEach((r) => {
						const lvNum = parseInt(r[0], 10);
						const tr = el('tr', S.power >= lvNum ? 'on' : '');
						r.forEach((c, ci) => {
							const lock = (ci === 2 && !S.superForm) || (ci === 3 && !S.triumphForm);
							tr.appendChild(el('td', lock ? 'lock' : '', c || '—'));
						});
						if (lv.extra) tr.appendChild(el('td', null, extraByLevel[lvNum] || '—'));
						tb.appendChild(tr);
					});
				} else {
					const heads = ['等級', '基礎形態', '超級形態', '凱旋形態'];
					if (lv.extra) heads.push(lv.extra.name);
					heads.forEach((h) => htr.appendChild(el('th', null, h)));
					lv.rows.forEach((r) => {
						const tr = el('tr', S.power >= r.level ? 'on' : '');
						tr.appendChild(el('td', null, String(r.level)));
						tr.appendChild(el('td', null, r.basic));
						tr.appendChild(el('td', S.superForm ? '' : 'lock', r.super || '—'));
						tr.appendChild(el('td', S.triumphForm ? '' : 'lock', r.triumph || '—'));
						if (lv.extra) tr.appendChild(el('td', null, extraByLevel[r.level] || '—'));
						tb.appendChild(tr);
					});
				}
				thead.appendChild(htr);
				tbl.appendChild(thead);
				tbl.appendChild(tb);
				const luxNote = el('p', 'tiny-note',
					'能力等級 ' + S.power +
					'　超級形態：' + (S.superForm ? '已解鎖' : '未解鎖') +
					'　凱旋形態：' + (S.triumphForm ? '已解鎖' : '未解鎖') +
					(lv.extra ? '　' + lv.extra.name + '：已取得' : '') +
					(lv.replace ? '　※ 量表已由「' + lv.replace.name + '」取代，使用暗點計算等級' : ''));
				p1.appendChild(sheetBlock('光之裝束・能力量表', [tbl, luxNote]));

				const hearts = (S.hearts || []).filter((h) => h.name || h.effect);
				if (hearts.length) {
					p1.appendChild(
						sheetBlock('心之力', [
							moveList(hearts.map((h) => ({ name: '（' + h.cat + '）' + (h.name || '未命名'), text: h.effect }))),
						])
					);
				}

				// 狀態
				const st = el('div', 'status');
				st.appendChild(kv('光點', String(S.light)));
				st.appendChild(kv('黑暗點數', String(S.dark)));
				st.appendChild(kv('黑暗等級', String(S.darkLv)));
				st.appendChild(kv('閃耀點數', S.shine + ' / ' + ((S.players || 4) + S.advances.length)));
				const consAll = pb.consequences.concat(['落敗']);
				const cbox = el('div', 'cons');
				consAll.forEach((c, i) => {
					const on = (S.cons || []).includes(i);
					const t = el('span', 'consitem' + (on ? ' on' : ''));
					t.appendChild(boxRow(1, on ? 1 : 0));
					t.appendChild(el('span', null, c));
					cbox.appendChild(t);
				});
				p1.appendChild(sheetBlock('狀態', [st, cbox]));

				if (S.bonds) p1.appendChild(sheetBlock('羈絆與備註', [el('p', 'freetext', S.bonds)]));
				root.appendChild(p1);

				// ---- 第 2 頁：動作 ----
				const p2 = el('div', 'page');
				p2.appendChild(el('h2', 'pagetitle', (S.name || '角色') + '・動作一覽'));

				// 所有可勾選的選項都完整列出，前方方框標示是否已選，方便實體桌面對照
				const picked = (list) => (items) => items.map((_, i) => list.includes(i));

				const sig = pb.signature;
				const sigNodes = [];
				if ((sig.granted || []).length) {
					sigNodes.push(el('p', 'tiny-note', '自動獲得'));
					sigNodes.push(moveList(sig.granted, sig.granted.map(() => true)));
				}
				const sigPool = sig.mode === 'options' ? sig.options : sig.chooseFrom;
				if ((sigPool || []).length) {
					const total = (sig.chooseCount || 0) + (S.sigExtra || 0);
					sigNodes.push(
						el('p', 'tiny-note', '可選 ' + total + ' 項　已選 ' + S.sig.length + ' 項')
					);
					sigNodes.push(moveList(sigPool, picked(S.sig)(sigPool)));
				}
				if (sigNodes.length) p2.appendChild(sheetBlock(pb.signatureName, sigNodes));

				p2.appendChild(
					sheetBlock(pb.name + '進階動作', [
						moveList(pb.advanceMoves, picked(S.advMoves)(pb.advanceMoves)),
					])
				);

				const pc = pact();
				if (pc) {
					if ((pc.advantages || []).length) {
						p2.appendChild(
							sheetBlock(pc.name + '・盟約優勢', [
								moveList(
									pc.advantages.map((a) => ({ name: a.name, text: a.text, table: a.table })),
									picked(S.pactAdv || [])(pc.advantages)
								),
							])
						);
					}
					if ((pc.moves || []).length) {
						p2.appendChild(
							sheetBlock(pc.name + '・盟約動作', [moveList(pc.moves, picked(S.pactMoves)(pc.moves))])
						);
					}
					if ((pc.coopMoves || []).length) {
						p2.appendChild(
							sheetBlock(pc.name + '・合作動作', [
								el('p', 'tiny-note', '勾選者為因黑暗等級而無法再觸發的動作'),
								moveList(pc.coopMoves, picked(S.lostCoop || [])(pc.coopMoves)),
							])
						);
					}
					const dmList = (pc.darkMoves || {})[S.pb] || [];
					if (dmList.length) {
						p2.appendChild(
							sheetBlock(S.pb + '黑暗動作', [moveList(dmList, picked(S.darkMoves || [])(dmList))])
						);
					}
				}
				const fb = frBook();
				const frAll = effFrMoves();
				if (fb) {
					p2.appendChild(
						sheetBlock('友情・' + fb.name, [moveList(fb.moves, picked(frAll)(fb.moves))])
					);
				}
				const rb = romBook();
				if (rb) {
					p2.appendChild(
						sheetBlock('戀愛・' + rb.name, [
							el('p', 'tiny-note', '戀愛扮演書的動作全部自動獲得'),
							moveList(rb.moves, rb.moves.map(() => true)),
						])
					);
				}

				const doneAdv = S.advances.filter((a) => a.done);
				if (doneAdv.length) {
					const ul = el('ul', 'mlist compact');
					doneAdv.forEach((a, i) => {
						const li = el('li');
						let detail = '';
						if (a.opt.indexOf('提升一項屬性') >= 0) detail = a.detail + ' +1';
						else if (a.opt.indexOf('進階動作') >= 0) detail = (pb.advanceMoves[a.detail] || {}).name || '';
						else if (a.opt.indexOf('友情扮演書動作') >= 0) {
							const fbx = frBook();
							detail = fbx ? (fbx.moves[a.detail] || {}).name || '' : '';
						} else if (a.detail === 'super') detail = '超級形態';
						else if (a.detail === 'triumph') detail = '凱旋形態';
						else if (a.detail === 'sig3') detail = '額外三個選項';
						li.appendChild(el('b', null, '第 ' + (i + 1) + ' 次：' + a.opt));
						if (detail) li.appendChild(el('span', null, detail));
						ul.appendChild(li);
					});
					p2.appendChild(sheetBlock('成長紀錄', [ul]));
				}
				p2.appendChild(sheetBlock('成長欄位', [advBoxTable('advboxes sheet')]));

				const basics = el('ul', 'mlist compact');
				RULES.basicMoves.forEach((m) => {
					const li = el('li');
					li.appendChild(el('b', null, m.name + (m.attribute && m.attribute !== '屬性' ? '（+' + m.attribute + '）' : '')));
					if (m.trigger) li.appendChild(el('span', null, m.trigger));
					basics.appendChild(li);
				});
				p2.appendChild(sheetBlock('基礎動作（全角色共通）', [basics]));
				root.appendChild(p2);
			}

			function render() {
				applyAdvances();
				renderBuilder();
				renderSheet();
				syncURL();
			}

			// ========== 匯出／匯入／分享／列印 ==========
			$('#btn-export').addEventListener('click', () => {
				const blob = new Blob([JSON.stringify(S, null, 2)], { type: 'application/json' });
				const a = el('a');
				a.href = URL.createObjectURL(blob);
				a.download = (S.name || 'maho-shojo') + '.json';
				a.click();
				setTimeout(() => URL.revokeObjectURL(a.href), 1000);
				toast('已匯出 JSON');
			});
			$('#btn-import').addEventListener('click', () => $('#file-input').click());
			$('#file-input').addEventListener('change', async (e) => {
				const f = e.target.files && e.target.files[0];
				if (!f) return;
				try {
					const obj = JSON.parse(await f.text());
					S = Object.assign(structuredClone(BLANK), obj);
					render();
					toast('已匯入 ' + f.name);
				} catch (err) {
					toast('匯入失敗：不是有效的角色 JSON');
				}
				e.target.value = '';
			});
			$('#btn-share').addEventListener('click', async () => {
				try {
					const code = await encodeState();
					const url = location.origin + location.pathname + '#c=' + code;
					history.replaceState(null, '', '#c=' + code);
					await navigator.clipboard.writeText(url);
					toast('已複製分享網址（' + url.length + ' 字元）');
				} catch (err) {
					toast('複製失敗，請手動複製網址列');
				}
			});
			$('#btn-print').addEventListener('click', () => window.print());
			$('#btn-reset').addEventListener('click', () => {
				if (!confirm('確定要清空目前的角色卡？')) return;
				S = structuredClone(BLANK);
				history.replaceState(null, '', location.pathname);
				render();
			});

			// ========== 初始化：讀取網址中的角色 ==========
			(async () => {
				const m = location.hash.match(/[#&]c=([^&]+)/);
				if (m) {
					try {
						S = Object.assign(structuredClone(BLANK), await decodeState(m[1]));
					} catch (e) {
						toast('網址中的角色資料無法解讀，已開新卡');
					}
				}
				render();
			})();
		</script>

		<style is:global>
			:root {
				--night: #12102a;
				--night-2: #1d1640;
				--panel: #241b4a;
				--star: #ffd98a;
				--ink: #f4eefe;
				--ink-dim: #b9aed6;
				--line: #3b2f68;
				--accent: #d066c0;
			}
			* { margin: 0; padding: 0; box-sizing: border-box; }
			body {
				min-height: 100%;
				background: radial-gradient(ellipse at 50% -10%, #241b4a, var(--night) 60%);
				color: var(--ink);
				font-family: 'Segoe UI', 'Noto Sans TC', 'Microsoft JhengHei', system-ui, sans-serif;
				line-height: 1.7;
			}
			button, input, select, textarea { font: inherit; color: inherit; }

			/* ---- 頂列 ---- */
			.topbar {
				position: sticky; top: 0; z-index: 20;
				display: flex; flex-wrap: wrap; gap: .75rem;
				align-items: center; justify-content: space-between;
				padding: .7rem 1.1rem;
				background: rgba(18, 16, 42, .92);
				border-bottom: 1px solid var(--line);
				backdrop-filter: blur(6px);
			}
			.brand { display: flex; align-items: baseline; gap: .6rem; }
			.brand .home { color: var(--star); text-decoration: none; font-size: 1.2rem; }
			.brand h1 { font-size: 1.15rem; letter-spacing: .04em; }
			.brand .sub { color: var(--ink-dim); font-size: .8rem; }
			.tools { display: flex; flex-wrap: wrap; gap: .4rem; }
			.tools button {
				padding: .35rem .8rem; border-radius: 999px; cursor: pointer;
				border: 1px solid var(--line); background: #1b1638; color: var(--ink);
				transition: background .15s, border-color .15s;
			}
			.tools button:hover { background: #2a2154; border-color: var(--accent); }
			.tools button.primary { background: var(--accent); border-color: var(--accent); color: #1a0f22; font-weight: 600; }
			.tools button.ghost { color: var(--ink-dim); }

			.toast {
				position: fixed; left: 50%; bottom: 1.4rem; transform: translateX(-50%) translateY(1rem);
				padding: .5rem 1rem; border-radius: 999px; z-index: 50;
				background: #2a2154; border: 1px solid var(--accent);
				opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s;
			}
			.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

			/* ---- 版面 ---- */
			.wrap {
				display: grid; gap: 1.1rem;
				grid-template-columns: minmax(320px, 1fr) minmax(320px, 1fr);
				align-items: start;
				padding: 1.1rem; max-width: 1500px; margin: 0 auto;
			}
			@media (max-width: 960px) { .wrap { grid-template-columns: 1fr; } }

			.builder { display: flex; flex-direction: column; gap: .7rem; }
			.step {
				border: 1px solid var(--line); border-radius: 12px;
				background: rgba(36, 27, 74, .55); overflow: hidden;
			}
			.step > summary {
				cursor: pointer; padding: .6rem .9rem; display: flex; gap: .6rem;
				align-items: baseline; background: rgba(45, 34, 92, .6);
			}
			.step > summary::marker { color: var(--star); }
			.stitle { font-weight: 600; letter-spacing: .03em; }
			.shint { color: var(--ink-dim); font-size: .8rem; }
			.step > *:not(summary) { margin: .55rem .9rem; }
			.step > *:last-child { margin-bottom: .9rem; }

			.note { color: var(--ink-dim); font-size: .85rem; }
			.note.dim { opacity: .75; font-size: .8rem; }
			ul.rules { margin-left: 2rem; color: var(--ink-dim); font-size: .85rem; }

			.fgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .5rem .7rem; }
			.field { display: flex; flex-direction: column; gap: .2rem; }
			.flabel { font-size: .78rem; color: var(--ink-dim); letter-spacing: .05em; }
			.field input, .field select, .field textarea, .heartrow input, .heartrow select {
				width: 100%; padding: .35rem .55rem; border-radius: 8px;
				border: 1px solid var(--line); background: #171233;
			}
			.field input:focus, .field textarea:focus { outline: 2px solid var(--accent); }
			.combo { display: block; }
			.combo input { width: 100%; padding: .35rem .55rem; border-radius: 8px; border: 1px solid var(--line); background: #171233; }
			input.num { max-width: 6rem; }

			.pbgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: .5rem; }
			.pbcard {
				display: flex; flex-direction: column; gap: .15rem; text-align: left;
				padding: .55rem .7rem; border-radius: 10px; cursor: pointer;
				border: 1px solid var(--line); background: #1b1638; color: var(--ink);
			}
			.pbcard:hover { border-color: var(--accent); }
			.pbcard.on { border-color: var(--star); background: #2c2258; box-shadow: 0 0 0 1px var(--star) inset; }
			.pbcard b { font-size: 1rem; }
			.pbmove { color: var(--star); font-size: .78rem; }
			.pbdesc { color: var(--ink-dim); font-size: .74rem; line-height: 1.5; }

			.setrow, .pactrow { display: flex; gap: .45rem; flex-wrap: wrap; }
			.setbtn, .pactbtn {
				padding: .4rem .7rem; border-radius: 10px; cursor: pointer; text-align: left;
				border: 1px solid var(--line); background: #1b1638; color: var(--ink); font-size: .85rem;
			}
			.setbtn b { display: block; }
			.setbtn.on, .pactbtn.on { border-color: var(--star); background: #2c2258; }

			.attrrow { display: grid; grid-template-columns: repeat(5, 1fr); gap: .4rem; }
			.attrcell {
				display: flex; flex-direction: column; align-items: center; gap: .1rem;
				padding: .4rem .2rem; border: 1px solid var(--line); border-radius: 10px; background: #171233;
			}
			.akey { font-size: .78rem; color: var(--ink-dim); }
			.aval { font-size: 1.35rem; color: var(--star); }
			.actrl { display: flex; gap: .2rem; }
			button.tiny {
				width: 1.5rem; height: 1.5rem; line-height: 1; cursor: pointer;
				border-radius: 6px; border: 1px solid var(--line); background: #221b45; color: var(--ink);
			}
			button.tiny:hover { border-color: var(--accent); }
			button.small {
				padding: .3rem .7rem; border-radius: 8px; cursor: pointer;
				border: 1px solid var(--line); background: #221b45; color: var(--ink); font-size: .85rem;
			}
			.chips { display: flex; gap: .35rem; flex-wrap: wrap; }
			.chip {
				padding: .15rem .55rem; border-radius: 999px; cursor: pointer; font-size: .78rem;
				border: 1px solid var(--accent); background: #2a2154; color: var(--ink);
			}

			.checklist { display: flex; flex-direction: column; gap: .35rem; }
			.checklist.compact { flex-direction: row; flex-wrap: wrap; gap: .5rem 1rem; }
			.check { display: flex; gap: .5rem; align-items: flex-start; cursor: pointer; }
			.check.inline { align-items: center; }
			.check input { margin-top: .45rem; accent-color: var(--accent); }
			.ctext { display: flex; flex-direction: column; }
			.ctext b { font-size: .9rem; }
			.cdesc { color: var(--ink-dim); font-size: .8rem; line-height: 1.6; }
			.granted { border-left: 2px solid var(--star); padding-left: .6rem; }
			.granted b { font-size: .9rem; }
			.granted p { color: var(--ink-dim); font-size: .82rem; white-space: pre-line; }

			table.minitable { width: 100%; border-collapse: collapse; font-size: .78rem; margin-top: .3rem; }
			table.minitable th, table.minitable td {
				border: 1px solid var(--line); padding: .12rem .4rem; text-align: center;
			}
			table.minitable th { background: rgba(45, 34, 92, .8); color: var(--star); font-weight: 500; }
			table.minitable.sheet { font-size: 8.5pt; color: #43385e; }
			table.minitable.sheet th, table.minitable.sheet td { border-color: #ddd2f2; }
			table.minitable.sheet th { background: #efe8fb; color: #55366e; }
			.note.ok { color: #8ce0b0; }
			.note.warn { color: #ffb3c7; }

			.advboxes { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; margin-top: .25rem; }
			.advboxes > .advboxcol > b { font-size: .8rem; color: var(--star); }
			ul.advboxlist { list-style: none; margin-top: .25rem; display: flex; flex-direction: column; gap: .18rem; }
			ul.advboxlist li { display: flex; gap: .35rem; font-size: .78rem; color: var(--ink-dim); }
			ul.advboxlist li.full { opacity: .5; text-decoration: line-through; }
			label.check.lost .ctext b { text-decoration: line-through; opacity: .65; }
			.advdesc {
				font-size: .78rem; color: var(--ink-dim); white-space: pre-line;
				border-left: 2px solid var(--line); padding: .1rem .5rem; margin-top: .35rem;
			}
			.boxrow { display: inline-flex; gap: .16em; flex: 0 0 auto; align-items: center; height: 1.2em; }
			.bx {
				width: .62em; height: .62em; border: 1px solid currentColor;
				border-radius: 2px; display: inline-block; box-sizing: border-box;
			}
			.bx.on { background: currentColor; }
			ul.advboxlist .boxrow { color: var(--star); }
			.advboxes.sheet > .advboxcol > b { font-size: 9.5pt; color: #4a2a6b; }
			.advboxes.sheet ul.advboxlist li { font-size: 9pt; color: #43385e; }
			.advboxes.sheet ul.advboxlist li.full { opacity: 1; text-decoration: none; }
			.advboxes.sheet .boxrow, .blk .boxrow { color: #7a5aa8; }
			.advcard {
				border: 1px solid var(--line); border-left: 3px solid var(--accent);
				border-radius: 10px; padding: .5rem .7rem; margin-bottom: .5rem;
				background: rgba(23, 18, 51, .6); display: flex; flex-direction: column; gap: .4rem;
			}
			.advcard.done { border-left-color: #8ce0b0; opacity: .92; }
			.advhead { display: flex; align-items: center; gap: .5rem; }
			.advhead b { font-size: .9rem; }
			.tagtype {
				font-size: .72rem; padding: .05rem .5rem; border-radius: 999px;
				border: 1px solid var(--line); color: var(--ink-dim);
			}
			.advhead .tiny { margin-left: auto; }
			.advcard select {
				width: 100%; padding: .3rem .5rem; border-radius: 8px;
				border: 1px solid var(--line); background: #171233;
			}
			.advdetail { display: flex; flex-direction: column; gap: .3rem; }
			.sublist { border: 1px dashed var(--line); border-radius: 10px; padding: .4rem .6rem; }
			.sublist summary { cursor: pointer; color: var(--ink-dim); font-size: .85rem; }
			button:disabled { opacity: .45; cursor: not-allowed; }

			.heartrow { display: grid; grid-template-columns: 1fr 7rem 1.4fr auto; gap: .35rem; align-items: center; }
			.heartrow input, .heartrow select { padding: .3rem .5rem; border-radius: 8px; border: 1px solid var(--line); background: #171233; }

			/* ---- 角色卡 ---- */
			.preview { position: sticky; top: 4rem; }
			.sheet { display: flex; flex-direction: column; gap: 1rem; }
			.page {
				background: #fdfbff; color: #241b3f;
				border-radius: 10px; padding: 12mm 10mm;
				box-shadow: 0 10px 30px rgba(0, 0, 0, .4);
				font-size: 10.5pt; line-height: 1.55;
			}
			.page.empty { color: #6b5f8c; text-align: center; padding: 4rem 1rem; }
			.shead { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
				border-bottom: 2px solid #d8cdf0; padding-bottom: .5rem; margin-bottom: .7rem; }
			.shead h2 { font-size: 16pt; line-height: 1.3; }
			.stitle2 { color: #7a4fa0; font-size: 10pt; }
			.pbtag { text-align: right; }
			.pbtag b { display: block; font-size: 12pt; color: #7a2f8f; }
			.pbtag span { font-size: 9pt; color: #6b5f8c; }
			.pagetitle { font-size: 13pt; border-bottom: 2px solid #d8cdf0; padding-bottom: .35rem; margin-bottom: .6rem; }

			.sattrs { display: grid; grid-template-columns: repeat(5, 1fr); gap: .35rem; margin-bottom: .7rem; }
			.sattr { text-align: center; border: 1px solid #d8cdf0; border-radius: 8px; padding: .25rem; }
			.sattr span { display: block; font-size: 8.5pt; color: #6b5f8c; }
			.sattr b { font-size: 14pt; color: #7a2f8f; }

			.blk { margin-bottom: .7rem; break-inside: avoid; }
			.blk h3 {
				font-size: 10pt; letter-spacing: .08em; color: #7a2f8f;
				border-bottom: 1px solid #e3daf5; margin-bottom: .3rem; padding-bottom: .1rem;
			}
			.cols2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
			.kv { display: flex; gap: .4rem; font-size: 9.5pt; }
			.kv .k { color: #6b5f8c; min-width: 5.5em; }
			.kv .v { flex: 1; border-bottom: 1px dotted #cfc3e8; }
			.status { display: grid; grid-template-columns: repeat(4, 1fr); gap: .3rem; }
			.cons { display: flex; flex-wrap: wrap; gap: .3rem .8rem; margin-top: .3rem; font-size: 9.5pt; }
			.consitem { display: inline-flex; align-items: center; gap: .3em; color: #6b5f8c; }
			.consitem.on { color: #b02a5b; font-weight: 600; }
			.freetext { white-space: pre-line; font-size: 9.5pt; }
			.tiny-note { font-size: 8.5pt; color: #6b5f8c; margin-top: .2rem; }

			table.lux { width: 100%; border-collapse: collapse; font-size: 9pt; }
			table.lux th, table.lux td { border: 1px solid #ddd2f2; padding: .18rem .35rem; text-align: center; }
			table.lux th { background: #efe8fb; color: #55366e; }
			table.lux tr.on td { background: #fbf3ff; }
			table.lux td.lock { color: #b3a8c9; }

			ul.mlist { list-style: none; display: flex; flex-direction: column; gap: .3rem; }
			ul.mlist li { break-inside: avoid; }
			ul.mlist b { display: flex; align-items: center; gap: .35em; font-size: 9.5pt; color: #4a2a6b; }
			ul.mlist b .mname { display: inline; font-size: inherit; color: inherit; }
			ul.mlist span { display: block; font-size: 9pt; color: #43385e; white-space: pre-line; }
			ul.mlist.compact span { color: #6b5f8c; }

			.foot {
				display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
				padding: 1rem 1.2rem 2rem; color: var(--ink-dim); font-size: .8rem;
			}
			.foot a { color: var(--star); }

			/* ---- 列印：A4，可多頁 ---- */
			@page { size: A4; margin: 12mm; }
			@media print {
				body { background: #fff; color: #000; }
				.no-print, .topbar, .foot, .toast { display: none !important; }
				.wrap { display: block; padding: 0; max-width: none; }
				.preview { position: static; }
				.sheet { gap: 0; }
				.page {
					box-shadow: none; border-radius: 0; padding: 0;
					background: #fff; break-after: page; page-break-after: always;
				}
				.page:last-child { break-after: auto; page-break-after: auto; }
			}
		</style>
	</body>
</html>
