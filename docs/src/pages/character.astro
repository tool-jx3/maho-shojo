			.check.inline { align-items: center; }
			.check input { margin-top: .45rem; accent-color: var(--accent); }
			.ctext { display: flex; flex-direction: column; }
			.ctext b { font-size: .9rem; }
			.cdesc { color: var(--ink-dim); font-size: .8rem; line-height: 1.6; }
			.granted { border-left: 2px solid var(--star); padding-left: .6rem; }
			.granted b { font-size: .9rem; }
			.granted p { color: var(--ink-dim); font-size: .82rem; white-space: pre-line; }

			.heartrow { display: grid; grid-template-columns: 1fr 7rem 1.4fr auto; gap: .35rem; align-items: center; }
			.heartrow input, .heartrow select { padding: .3rem .5rem; border-radius: 8px; border: 1px solid var(--line); background: #171233; }

			/* ---- 角色卡 ---- */
			.preview { position: sticky; top: 4rem; }
			.sheet { display: flex; flex-direction: column; gap: 1rem; }
			.page {
				background: #fdfbff; color: #241b3f;
				border-radius: 10px; padding: 12mm 10mm;
				box-shadow: 0 10px 30px rgba(0, 0, 0, .4);
				font-size: 10.5pt; line-height: 1.55;
			}
			.page.empty { color: #6b5f8c; text-align: center; padding: 4rem 1rem; }
			.shead { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
				border-bottom: 2px solid #d8cdf0; padding-bottom: .5rem; margin-bottom: .7rem; }
			.shead h2 { font-size: 16pt; line-height: 1.3; }
			.stitle2 { color: #7a4fa0; font-size: 10pt; }
			.pbtag { text-align: right; }
			.pbtag b { display: block; font-size: 12pt; color: #7a2f8f; }
			.pbtag span { font-size: 9pt; color: #6b5f8c; }
			.pagetitle { font-size: 13pt; border-bottom: 2px solid #d8cdf0; padding-bottom: .35rem; margin-bottom: .6rem; }

			.sattrs { display: grid; grid-template-columns: repeat(5, 1fr); gap: .35rem; margin-bottom: .7rem; }
			.sattr { text-align: center; border: 1px solid #d8cdf0; border-radius: 8px; padding: .25rem; }
			.sattr span { display: block; font-size: 8.5pt; color: #6b5f8c; }
			.sattr b { font-size: 14pt; color: #7a2f8f; }

			.blk { margin-bottom: .7rem; break-inside: avoid; }
			.blk h3 {
				font-size: 10pt; letter-spacing: .08em; color: #7a2f8f;
				border-bottom: 1px solid #e3daf5; margin-bottom: .3rem; padding-bottom: .1rem;
			}
			.cols2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
			.kv { display: flex; gap: .4rem; font-size: 9.5pt; }
			.kv .k { color: #6b5f8c; min-width: 5.5em; }
			.kv .v { flex: 1; border-bottom: 1px dotted #cfc3e8; }
			.status { display: grid; grid-template-columns: repeat(4, 1fr); gap: .3rem; }
			.cons { display: flex; flex-wrap: wrap; gap: .3rem .8rem; margin-top: .3rem; font-size: 9.5pt; }
			.consitem.on { color: #b02a5b; font-weight: 600; }
			.freetext { white-space: pre-line; font-size: 9.5pt; }
			.tiny-note { font-size: 8.5pt; color: #6b5f8c; margin-top: .2rem; }

			table.lux { width: 100%; border-collapse: collapse; font-size: 9pt; }
			table.lux th, table.lux td { border: 1px solid #ddd2f2; padding: .18rem .35rem; text-align: center; }
			table.lux th { background: #efe8fb; color: #55366e; }
			table.lux tr.on td { background: #fbf3ff; }
			table.lux td.lock { color: #b3a8c9; }

			ul.mlist { list-style: none; display: flex; flex-direction: column; gap: .3rem; }
			ul.mlist li { break-inside: avoid; }
			ul.mlist b { display: block; font-size: 9.5pt; color: #4a2a6b; }
			ul.mlist span { display: block; font-size: 9pt; color: #43385e; white-space: pre-line; }
			ul.mlist.compact span { color: #6b5f8c; }

			.foot {
				display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
				padding: 1rem 1.2rem 2rem; color: var(--ink-dim); font-size: .8rem;
			}
			.foot a { color: var(--star); }

			/* ---- 列印：A4，可多頁 ---- */
			@page { size: A4; margin: 12mm; }
			@media print {
				body { background: #fff; color: #000; }
				.no-print, .topbar, .foot, .toast { display: none !important; }
				.wrap { display: block; padding: 0; max-width: none; }
				.preview { position: static; }
				.sheet { gap: 0; }
				.page {
					box-shadow: none; border-radius: 0; padding: 0;
					background: #fff; break-after: page; page-break-after: always;
				}
				.page:last-child { break-after: auto; page-break-after: auto; }
			}
		</style>
	</body>
